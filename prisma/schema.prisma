// Procurement Operating System — relational data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection for the application: serverless functions open and close
  // constantly, and Postgres will not take that directly.
  url       = env("DATABASE_URL")
  // Unpooled connection for schema pushes and migrations, which the pooler
  // cannot carry.
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// IDENTITY, RBAC & ORG MODEL
// ─────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  title        String?
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  primaryEntityId     String?
  primaryEntity       Entity?     @relation("UserPrimaryEntity", fields: [primaryEntityId], references: [id])
  primaryDepartmentId String?
  primaryDepartment   Department? @relation("UserPrimaryDept", fields: [primaryDepartmentId], references: [id])

  /// Where this person sits on the supply chain organogram. `grade` is a code
  /// from GRADES in src/lib/org.ts; `reportsTo` is the named line manager, which
  /// may differ from the grade's default parent where the organogram says so.
  grade       String?
  scmFunction String?
  reportsToId String?
  reportsTo   User?   @relation("OrgLine", fields: [reportsToId], references: [id])
  reports     User[]  @relation("OrgLine")
  /// Position number on the source organogram, so the printed order is kept.
  orgPosition Int?

  notifyInApp  Boolean @default(true)
  notifyEmail  Boolean @default(false)
  notifyDigest Boolean @default(true)

  roles         UserRole[]
  entityAccess  UserEntityAccess[]
  sessions      Session[]
  auditLogs     AuditLog[]
  notifications Notification[]
  tasks         Task[]             @relation("TaskAssignee")

  requisitions       PurchaseRequisition[] @relation("PRRequester")
  approvalActions    ApprovalAction[]
  approvalsEscalatedTo ApprovalAction[]    @relation("ApprovalEscalatedTo")
  cpcCeoDecisions      CpcCase[]           @relation("CpcCeoDecision")
  cpcRosterSeats       CpcRosterMember[]   @relation("CpcRosterUser")
  revisionsCreated     DocumentRevision[]  @relation("RevisionCreatedBy")
  cpcDecisionsCirculated CpcCase[]         @relation("CpcDecisionCirculatedBy")

  // Build-outs and the RNC.
  buildOutsCreated        BuildOut[]            @relation("BuildOutCreatedBy")
  buildOutsApproved       BuildOut[]            @relation("BuildOutManagementApproval")
  buildOutRequirements    BuildOut[]            @relation("BuildOutRequirements")
  buildOutTasksOwned      BuildOutTask[]        @relation("BuildOutTaskOwner")
  buildOutTasksUpdated    BuildOutTask[]        @relation("BuildOutTaskUpdatedBy")
  cfcMeetingsCalled       CfcMeeting[]          @relation("CfcMeetingCalledBy")
  cfcSeats                CfcMember[]           @relation("CfcMemberPrimary")
  cfcProxySeats           CfcMember[]           @relation("CfcMemberProxy")
  cfcProxyAttendance      CfcAttendance[]       @relation("CfcProxyAttended")
  boqMeasurements         BuildOutBoqLine[]     @relation("BoqMeasuredBy")
  scheduleChecks          BuildOutScheduleDay[] @relation("ScheduleCheckedBy")
  lessonsRaised           BuildOutLesson[]      @relation("LessonRaisedBy")
  rncSeats                RncMember[]           @relation("RncMemberUser")
  rncCasesCreated         RncCase[]             @relation("RncCaseCreatedBy")
  rfqsCreated        Rfq[]                 @relation("RfqCreatedBy")
  negotiations       Negotiation[]
  posCreated         PurchaseOrder[]       @relation("PoCreatedBy")
  gatePasses         GatePass[]            @relation("GatePassRecordedBy")
  deliveriesReceived Delivery[]            @relation("DeliveryReceivedBy")
  inspections        Inspection[]          @relation("InspectionInspector")
  grns               Grn[]                 @relation("GrnReceivedBy")
  grnsPosted         Grn[]                 @relation("GrnPostedBy")
  grnTreatmentsApproved GrnItem[]          @relation("GrnTreatmentApprover")
  manualComparativeEntries ComparativeManualEntry[] @relation("ManualEntryEnteredBy")
  attestationsSigned     Attestation[]           @relation("AttestationSignedBy")
  attestationsOnBehalfOf Attestation[]           @relation("AttestationOnBehalfOf")
  prsApproved            PurchaseRequisition[]   @relation("PrApprovedBy")
  taxRulesCreated    TaxRule[]             @relation("TaxRuleCreatedBy")
  taxRulesApproved   TaxRule[]             @relation("TaxRuleApprovedBy")
  serviceAcceptancePocs      ServiceAcceptance[] @relation("ServiceAcceptancePoc")
  serviceAcceptancesConfirmed ServiceAcceptance[] @relation("ServiceAcceptanceConfirmedBy")
  serviceAcceptancesCreated   ServiceAcceptance[] @relation("ServiceAcceptanceCreatedBy")
  invoicesVerified   Invoice[]             @relation("InvoiceVerifiedBy")
  vendorEvaluations  VendorEvaluation[]
  cpcMemberships     CpcCaseMember[]
  cpcDecisions       CpcDecision[]
  documents          Document[]
  exceptionsOwned    Exception[]           @relation("ExceptionOwner")
  exceptionsRaised   Exception[]           @relation("ExceptionRaisedBy")
  pettyCash          PettyCashRequest[]    @relation("PettyCashRequester")
  storeIssues        StoreIssue[]          @relation("IssueRequestedBy")
  storeTransfers     StoreTransfer[]       @relation("TransferRequestedBy")
  assetsHeld         Asset[]               @relation("AssetCustodian")
  disposalCases      DisposalCase[]        @relation("DisposalRaisedBy")
  vendorIssues       VendorIssue[]         @relation("VendorIssueRaisedBy")
  savedViews         SavedView[]
  stacking           GoodsStacking[]       @relation("StackedBy")
  paymentHandoffs    PaymentHandoff[]      @relation("HandoffBy")
  emails             EmailMessage[]

  requirementsRaised  Requirement[]          @relation("RequirementRequester")
  requirementsDecided Requirement[]          @relation("RequirementDecidedBy")
  reservationsMade    InventoryReservation[] @relation("ReservationCreatedBy")
  allocationsMade     PrPoAllocation[]       @relation("AllocationCreatedBy")

  vouchersPrepared  Voucher[]           @relation("VoucherPreparedBy")
  signatoriesGiven  SignatoryApproval[] @relation("SignatoryUser")
  variancesResolved PoVariance[]        @relation("VarianceResolvedBy")
  rejectionsRaised  RejectionRecord[]   @relation("RejectionRaisedBy")
  returnsRaised     VendorReturn[]      @relation("ReturnRaisedBy")
  pocRoles          DepartmentPoc[]     @relation("PocUser")
  comparativePocs   Comparative[]       @relation("ComparativePoc")
  comparativesVerified Comparative[]    @relation("ComparativeVerifiedBy")

  serialUnitsHeld   SerialUnit[]     @relation("SerialCustodian")
  serialMovements   SerialMovement[] @relation("SerialMovementBy")
  paymentPackVerifications PaymentPackItem[] @relation("PaymentPackVerifiedBy")
  paymentPackExceptions    PaymentPackItem[] @relation("PaymentPackExceptionBy")
  minStockSet Item[] @relation("MinStockSetBy")
  inspectionSignoffs InspectionSignoff[] @relation("InspectionSignoffBy")
  minutesPrepared      NegotiationMinute[]      @relation("MinutePreparedBy")
  minuteParticipations NegotiationParticipant[] @relation("MinuteParticipant")
  posSigned PurchaseOrder[] @relation("PoAuthorisedSignatory")
  workOrdersCreated  WorkOrder[] @relation("WorkOrderCreatedBy")
  workOrdersIssued   WorkOrder[] @relation("WorkOrderIssuedBy")
  workOrdersAudited  WorkOrder[] @relation("WorkOrderAudit")
  priceCompPrepared  PriceCompetitivenessReview[] @relation("PriceCompPreparedBy")
  priceCompEmergency PriceCompetitivenessReview[] @relation("PriceCompEmergencyBy")
  disposalsInspected    DisposalCase[]    @relation("DisposalInspectedBy")
  disposalsFinanced     DisposalCase[]    @relation("DisposalFinanceBy")
  disposalsHeadConsult  DisposalCase[]    @relation("DisposalBusinessHead")
  disposalWitnessed     DisposalWitness[] @relation("DisposalWitnessUser")
  stockCountsCreated  StockCount[] @relation("StockCountCreatedBy")
  stockCountsCounted  StockCount[] @relation("StockCountCountedBy")
  stockCountsReviewed StockCount[] @relation("StockCountReviewedBy")
  stockCountsApproved StockCount[] @relation("StockCountApprovedBy")
  employeeReturnsCreated   EmployeeReturn[] @relation("EmployeeReturnCreatedBy")
  employeeReturnsMade      EmployeeReturn[] @relation("EmployeeReturnBy")
  employeeReturnsReceived  EmployeeReturn[] @relation("EmployeeReturnReceivedBy")
  employeeReturnsInspected EmployeeReturn[] @relation("EmployeeReturnInspectedBy")
  exceptionsAcknowledged Exception[]  @relation("ExceptionAcknowledgedBy")
  exceptionsEscalatedTo  Exception[]  @relation("ExceptionEscalatedTo")
  controlRunsPerformed   ControlRun[] @relation("ControlRunPerformedBy")
  controlRunsWaived      ControlRun[] @relation("ControlRunWaivedBy")
  contractsCreated  Contract[]      @relation("ContractCreatedBy")
  contractsSigned   Contract[]      @relation("ContractSignatory")
  contractEvents    ContractEvent[] @relation("ContractEventActor")
  delegationsGranted  Delegation[]     @relation("DelegationFrom")
  delegationsHeld     Delegation[]     @relation("DelegationTo")
  delegationsRecorded Delegation[]     @relation("DelegationRecordedBy")
  delegationsRevoked  Delegation[]     @relation("DelegationRevokedBy")
  delegationUses      DelegationUse[]  @relation("DelegationUsedBy")
  policiesCreated     PolicyDocument[] @relation("PolicyCreatedBy")
  policyAcks          PolicyAcknowledgement[] @relation("PolicyAcknowledgedBy")
  lossesReported     LossReport[] @relation("LossReportedBy")
  lossesInvestigated LossReport[] @relation("LossInvestigator")
  lossesConcluded    LossReport[] @relation("LossConcludedBy")
  @@index([email])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([token])
  @@map("sessions")
}

model Role {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  rank        Int     @default(0)
  isSystem    Boolean @default(false)

  permissions   RolePermission[]
  users         UserRole[]
  approvalSteps ApprovalRuleStep[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  group       String
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Entity {
  id        String   @id @default(cuid())
  code      String   @unique
  taxRules           TaxRule[]
  serviceAcceptances ServiceAcceptance[]
  name      String
  legalName String?
  currency  String   @default("PKR")
  address   String?
  city      String?
  taxNumber String?
  logoText  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  departments    Department[]
  projects       Project[]
  sites          Site[]
  stores         Store[]
  categories     Category[]
  users          User[]                @relation("UserPrimaryEntity")
  userAccess     UserEntityAccess[]
  requisitions   PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]
  approvalRules  ApprovalRule[]
  configs        ConfigSetting[]
  vendors        VendorEntityLink[]
  assets         Asset[]
  cpcMeetings    CpcMeeting[]
  disposalCases  DisposalCase[]
  pettyCash      PettyCashRequest[]

  requirements Requirement[]
  costCenters  CostCenter[]

  budgets       Budget[]
  taxes         Tax[]
  vouchers      Voucher[]
  uoms          Uom[]
  itemCodeRules ItemCodeRule[]

  paymentPackRequirements PaymentPackRequirement[]
  inspectionResponsibilities InspectionResponsibility[]
  negotiationMinutes NegotiationMinute[]
  workOrders WorkOrder[]
  stockCounts StockCount[]
  employeeReturns EmployeeReturn[]
  controlDefinitions ControlDefinition[]
  contracts Contract[]
  delegations    Delegation[]
  policyDocuments PolicyDocument[]
  lossReports LossReport[]
  @@map("entities")

  buildOuts       BuildOut[]
  cfcMembers      CfcMember[]
  cpcRosterMembers CpcRosterMember[]
  rncMembers RncMember[]
  rncCases   RncCase[]
}

model UserEntityAccess {
  userId   String
  entityId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([userId, entityId])
  @@map("user_entity_access")
}

model Department {
  id         String  @id @default(cuid())
  code       String
  name       String
  entityId   String
  entity     Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  headId     String?
  costCenter String?
  active     Boolean @default(true)

  users         User[]                @relation("UserPrimaryDept")
  requisitions  PurchaseRequisition[]
  approvalRules ApprovalRule[]
  assets        Asset[]
  pettyCash     PettyCashRequest[]

  requirements Requirement[]
  costCenters  CostCenter[]

  budgets Budget[]
  pocs    DepartmentPoc[]

  @@unique([entityId, code])
  @@map("departments")

  buildOutTasks BuildOutTask[]
}

model Project {
  id        String    @id @default(cuid())
  code      String    @unique
  name      String
  entityId  String
  entity    Entity    @relation(fields: [entityId], references: [id], onDelete: Cascade)
  city      String?
  status    String    @default("Active")
  managerId String?
  budget    Float?
  startDate DateTime?
  endDate   DateTime?

  sites        Site[]
  requisitions PurchaseRequisition[]
  stores       Store[]
  inventory    InventoryItem[]

  requirements Requirement[]
  buildOuts    BuildOut[]

  @@map("projects")
}

model Site {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  address   String?
  city      String?
  active    Boolean  @default(true)

  stores       Store[]
  requisitions PurchaseRequisition[]

  requirements Requirement[]
  buildOuts    BuildOut[]

  @@map("sites")
}

model Store {
  id String @id @default(cuid())

  code String @unique
  name String

  /// CENTRAL_WAREHOUSE | SITE_STORE | OFFICE_STORE | PROJECT_STORE | OTHER
  kind      String
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  address   String?
  city      String?
  managerId String?
  active    Boolean  @default(true)

  locations      StoreLocation[]
  inventory      InventoryItem[]
  transactions   InventoryTransaction[]
  grns           Grn[]
  gatePasses     GatePass[]
  deliveries     Delivery[]
  requisitions   PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]
  issues         StoreIssue[]
  transfersFrom  StoreTransfer[]        @relation("TransferFrom")
  transfersTo    StoreTransfer[]        @relation("TransferTo")
  stacking       GoodsStacking[]

  requirements     Requirement[]
  reservations     InventoryReservation[]
  sourcedIssues    StoreIssue[]           @relation("IssueSourceStore")
  requirementLines RequirementItem[]

  serialUnits SerialUnit[]
  costLayers CostLayer[]
  stockCounts StockCount[]
  employeeReturns EmployeeReturn[]
  lossReports LossReport[]
  @@map("stores")
}

model StoreLocation {
  id      String  @id @default(cuid())
  storeId String
  store   Store   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone    String?
  rack    String?
  bin     String?
  label   String

  /// GENERAL | HIGH_VALUE | SENSITIVE | HAZARDOUS | PROJECT_MATERIAL
  handling String  @default("GENERAL")
  capacity Float?
  active   Boolean @default(true)

  inventory InventoryItem[]
  stacking  GoodsStacking[]

  serialUnits SerialUnit[]
  @@unique([storeId, label])
  @@map("store_locations")
}

model Category {
  id       String     @id @default(cuid())
  code     String     @unique
  name     String
  entityId String?
  entity   Entity?    @relation(fields: [entityId], references: [id])
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  /// Does this category require technical inspection on receipt?
  requiresInspection Boolean @default(false)
  inspectionTemplate String?

  /// Default disposition: INVENTORY | CONSUMABLE | EXPENSE | ASSET | PROJECT_MATERIAL
  defaultDisposition String  @default("INVENTORY")
  assetTagRequired   Boolean @default(false)
  active             Boolean @default(true)

  items            Item[]
  requisitionItems PurchaseRequisitionItem[]
  approvalRules    ApprovalRule[]
  assets           Asset[]

  requirementItems RequirementItem[]
  budgets          Budget[]
  itemCodeRules    ItemCodeRule[]

  /// Which column of the SOP's inspection chart this category falls under.
  /// Null means the chart is silent about it — the chart covers seven office and
  /// consumable groups and says nothing about construction, MEP, machinery or
  /// vehicles — and silence is reported rather than guessed at.
  inspectionGroup String?
  @@map("categories")
}

model Item {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  unit          String   @default("EA")
  brand         String?
  model         String?
  make          String?
  specification String?
  hsCode        String?

  /// Standard/last known price for variance analysis
  standardPrice Float?
  trackSerial   Boolean @default(false)
  trackBatch    Boolean @default(false)
  trackExpiry   Boolean @default(false)
  reorderLevel  Float?
  active        Boolean @default(true)
  /// Where `reorderLevel` came from. ZAM/PUR/SOP-01 §3.3 gives Manager Logistics
  /// two grounds for a minimum stock level — past consumption, or the advice of
  /// the requesting department's POC — and the two are not interchangeable. A
  /// number nobody can attribute is a number nobody defends when stock runs out.
  ///
  /// MANUAL | CONSUMPTION | POC_ADVICE
  minStockBasis     String?
  minStockBasisNote String?
  minStockSetAt     DateTime?
  minStockSetById   String?
  minStockSetBy     User?     @relation("MinStockSetBy", fields: [minStockSetById], references: [id])

  requisitionItems PurchaseRequisitionItem[]
  quoteItems       QuoteItem[]
  poItems          PurchaseOrderItem[]
  grnItems         GrnItem[]
  inventory        InventoryItem[]
  transactions     InventoryTransaction[]
  priceHistory     PriceHistory[]
  assets           Asset[]
  issueItems       StoreIssueItem[]
  transferItems    StoreTransferItem[]
  deliveryItems    DeliveryItem[]
  inspectionItems  InspectionItem[]
  invoiceItems     InvoiceItem[]
  pettyCashItems   PettyCashItem[]
  stacking         GoodsStacking[]

  /// RC-016 — which of Annexure 5's ten stacking categories this belongs to.
  /// Separate from `categoryId`, which is the procurement taxonomy.
  stackingCategoryId String?
  stackingCategory   StackingCategory? @relation(fields: [stackingCategoryId], references: [id])
  disposalItems    DisposalItem[]

  requirementItems RequirementItem[]
  reservations     InventoryReservation[]

  rejections  RejectionRecord[]
  returnLines VendorReturnItem[]

  serialUnits SerialUnit[]
  costLayers CostLayer[]
  stockCountLines StockCountLine[]
  employeeReturnLines EmployeeReturnItem[]
  lossReportLines LossReportItem[]
  @@index([categoryId])
  @@map("items")
}

model PriceHistory {
  id        String  @id @default(cuid())
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  vendorId  String?
  vendor    Vendor? @relation(fields: [vendorId], references: [id])
  unitPrice Float
  currency  String  @default("PKR")
  quantity  Float?

  /// PO | QUOTE | MARKET | PETTY_CASH
  source     String
  sourceRef  String?
  recordedAt DateTime @default(now())

  @@index([itemId, recordedAt])
  @@map("price_history")
}

// ─────────────────────────────────────────────────────────────
// CONFIGURATION / BUSINESS RULE ENGINE
// ─────────────────────────────────────────────────────────────

model ConfigSetting {
  id  String @id @default(cuid())
  key String

  /// JSON-encoded value
  value       String
  valueType   String   @default("string")
  label       String
  description String?
  group       String   @default("General")
  entityId    String?
  entity      Entity?  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@unique([key, entityId])
  @@map("config_settings")
}

model ApprovalRule {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  /// PR | PO | INVOICE | PETTY_CASH | DISPOSAL | VENDOR | STORE_TRANSFER | MATERIAL_DEMAND
  documentType String
  entityId     String?
  entity       Entity?     @relation(fields: [entityId], references: [id], onDelete: Cascade)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])

  /// MONTHLY_RECURRING | ON_DEMAND | MATERIAL_DEMAND | PETTY_CASH | SERVICE | any
  procurementType String?
  minAmount       Float    @default(0)
  maxAmount       Float?
  priority        Int      @default(100)
  requiresCpc     Boolean  @default(false)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  steps     ApprovalRuleStep[]
  instances ApprovalInstance[]

  @@index([documentType, entityId])
  @@map("approval_rules")
}

model ApprovalRuleStep {
  id       String       @id @default(cuid())
  ruleId   String
  rule     ApprovalRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  sequence Int
  name     String
  roleId   String?
  role     Role?        @relation(fields: [roleId], references: [id])

  /// ROLE | DEPARTMENT_HEAD | CPC | SPECIFIC_USER
  /// ROLE | SPECIFIC_USER | DEPARTMENT_HEAD | CPC | LINE_MANAGER | GRADE.
  /// LINE_MANAGER and GRADE read the supply chain organogram rather than a role,
  /// which is how a step names one person instead of everybody who holds a role.
  approverType   String  @default("ROLE")
  specificUserId String?
  gradeCode      String?

  /// Hours allowed before the step is flagged overdue
  slaHours        Int     @default(24)
  commentRequired Boolean @default(false)

  /// All assignees must approve vs any one
  requireAll Boolean @default(false)
  optional   Boolean @default(false)

  actions ApprovalAction[]

  @@unique([ruleId, sequence])
  @@map("approval_rule_steps")
}

model ApprovalInstance {
  id           String        @id @default(cuid())
  ruleId       String?
  rule         ApprovalRule? @relation(fields: [ruleId], references: [id])
  documentType String
  documentId   String
  documentRef  String
  entityId     String?
  amount       Float         @default(0)

  /// PENDING | APPROVED | REJECTED | RETURNED | CLARIFICATION | CANCELLED
  status          String    @default("PENDING")
  currentSequence Int       @default(1)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  actions ApprovalAction[]

  @@index([documentType, documentId])
  @@index([status])
  @@map("approval_instances")
}

model ApprovalAction {
  id         String            @id @default(cuid())
  instanceId String
  instance   ApprovalInstance  @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId     String?
  step       ApprovalRuleStep? @relation(fields: [stepId], references: [id])
  sequence   Int
  stepName   String
  actorId    String?
  actor      User?             @relation(fields: [actorId], references: [id])

  /// PENDING | APPROVED | REJECTED | RETURNED | CLARIFICATION_REQUESTED | SKIPPED | DELEGATED
  action           String    @default("PENDING")
  comment          String?
  assignedRoleCode String?
  assignedAt       DateTime  @default(now())
  dueAt            DateTime?
  actedAt          DateTime?

  /// ── SLA escalation ────────────────────────────────────────────
  ///
  /// `slaHours` set a due date and nothing ever read it while the step was still
  /// waiting. Lateness was noticed only when somebody finally acted — which is
  /// the one moment it no longer matters. A step nobody touched sat forever.
  ///
  /// Escalating does **not** move the approval. Whoever was assigned is still
  /// the only person who can decide it; delegation is the sanctioned way to hand
  /// that over, and letting a missed deadline transfer authority would make the
  /// deadline a way around the approver. What escalation does is tell somebody
  /// above them, on the record, and keep count.
  escalationLevel Int       @default(0)
  escalatedAt     DateTime?
  escalatedToId   String?
  escalatedTo     User?     @relation("ApprovalEscalatedTo", fields: [escalatedToId], references: [id])

  @@index([instanceId, sequence])
  @@index([action, dueAt])
  @@map("approval_actions")
}

// ─────────────────────────────────────────────────────────────
// PURCHASE REQUISITIONS / MATERIAL DEMAND
// ─────────────────────────────────────────────────────────────

model PurchaseRequisition {
  id           String     @id @default(cuid())
  number       String     @unique
  entityId     String
  entity       Entity     @relation(fields: [entityId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  requesterId  String
  requester    User       @relation("PRRequester", fields: [requesterId], references: [id])

  /// MONTHLY_RECURRING | ON_DEMAND | MATERIAL_DEMAND | SERVICE
  procurementType      String
  /// GOODS | SERVICES
  ///
  /// Orthogonal to `procurementType`, which mixes cadence with kind — SERVICE
  /// sits there beside ON_DEMAND, so a monthly requisition for grocery and a
  /// monthly requisition for cleaning could not be told apart. This says which
  /// of the two procurement treatments applies, and nothing else.
  ///
  /// Goods take the receiving path: gate pass, delivery, inspection, GRN,
  /// inventory. Services take service acceptance and never touch inventory.
  procurementKind String @default("GOODS")

  /// The policy that governed this transaction, snapshotted at the point of
  /// decision. A later change to configuration must never rewrite what was
  /// decided under the old rules.
  policyDocument String? @default("ZAM/PUR/SOP-01")
  policyVersion  String? @default("01")
  /// JSON: the effective configuration values that applied.
  policySnapshot String?

  title                String
  justification        String?
  projectId            String?
  project              Project? @relation(fields: [projectId], references: [id])
  siteId               String?
  site                 Site?    @relation(fields: [siteId], references: [id])
  costCenter           String?
  /// CAPEX | OPEX — carried through to the order, receipt and finance treatment
  expenditureType      String   @default("OPEX")
  costCenterId         String?
  deliveryStoreId      String?
  deliveryStore        Store?   @relation(fields: [deliveryStoreId], references: [id])
  deliveryLocationNote String?
  /// Annexure 1 "Req Location" — where the goods are actually wanted, which is
  /// not always the store that receives them.
  requiredLocation String?

  /// Annexure 1 "Document Comments" — a note about the requisition as a whole,
  /// distinct from the business justification for buying.
  documentComments String?

  /// ── Controlled amendment ────────────────────────────────────────────────
  ///
  /// The version the document currently reflects, and the version the standing
  /// approval was given against. When they differ, the approval no longer covers
  /// what is there — which is the whole reason to keep both.
  revisionVersion  Int     @default(1)
  approvedVersion  Int?
  amendmentCount   Int     @default(0)
  lastAmendmentReason String?

  /// Annexure 1 "Approved By". `approvedAt` recorded when, never who.
  approvedById String?
  approvedBy   User?   @relation("PrApprovedBy", fields: [approvedById], references: [id])
  requiredDate         DateTime

  /// LOW | NORMAL | HIGH | URGENT
  priority       String  @default("NORMAL")
  budgetAmount   Float?
  budgetCode     String?
  estimatedValue Float   @default(0)
  currency       String  @default("PKR")

  /// ZD MD fields
  pmOwnerId        String?
  boqReference     String?
  drawingReference String?
  technicalNotes   String?

  status       String    @default("DRAFT")
  submittedAt  DateTime?
  approvedAt   DateTime?
  closedAt     DateTime?
  cancelledAt  DateTime?
  holdReason   String?
  returnReason String?
  rejectReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items          PurchaseRequisitionItem[]
  rfqs           Rfq[]
  purchaseOrders PurchaseOrder[]
  cpcCases       CpcCase[]
  comparatives   Comparative[]
  exceptions     Exception[]

  requirementId String?
  /// A sibling requisition raised from the same business need.
  ///
  /// One need can require both goods and a service — genset oil, and the oil
  /// testing that goes with it. They must follow separate procurement treatment,
  /// so they are separate requisitions, but they have to stay visible together.
  /// Where the need came through Requirements, `requirementId` already links
  /// them; this covers the case where it did not.
  linkedPrId String?
  linkedPr   PurchaseRequisition?  @relation("LinkedProcurement", fields: [linkedPrId], references: [id])
  linkedBy   PurchaseRequisition[] @relation("LinkedProcurement")

  requirement   Requirement?     @relation(fields: [requirementId], references: [id])
  allocations   PrPoAllocation[]

  negotiationMinutes NegotiationMinute[]
  workOrders WorkOrder[]
  contracts Contract[]
  @@index([entityId, status])
  @@index([status])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id            String              @id @default(cuid())
  prId          String
  pr            PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  lineNo        Int
  itemId        String?
  item          Item?               @relation(fields: [itemId], references: [id])
  categoryId    String
  category      Category            @relation(fields: [categoryId], references: [id])
  description   String
  brand         String?
  model         String?
  make          String?
  specification String?
  quantity      Float
  unit          String

  estimatedUnitPrice Float?
  estimatedTotal     Float     @default(0)
  requiredDate       DateTime?

  /// INVENTORY | CONSUMABLE | EXPENSE | ASSET | PROJECT_MATERIAL
  disposition String  @default("INVENTORY")
  /// GOODS | SERVICES — per line, so a requisition can be checked for being
  /// one kind or the other rather than trusted to be.
  procurementKind String @default("GOODS")

  notes       String?
  /// Annexure 1 "Item Code". Catalogue items have one through `item.sku`; this
  /// carries the code for something not yet in the catalogue, which is most of
  /// what a requisition asks for.
  itemCode String?

  /// Annexure 1 "In Stock" — the free quantity at the moment the requisition was
  /// raised. A snapshot, not a live figure: the point of the column is what the
  /// requester could see when they decided to buy.
  inStockAtRequest Float?
  stockCheckedAt   DateTime?

  quoteItems QuoteItem[]
  poItems    PurchaseOrderItem[]

  allocations PrPoAllocation[]

  @@unique([prId, lineNo])
  @@map("purchase_requisition_items")
}

// ─────────────────────────────────────────────────────────────
// RFQ / QUOTATIONS / COMPARATIVE / NEGOTIATION
// ─────────────────────────────────────────────────────────────

model Rfq {
  id                  String              @id @default(cuid())
  number              String              @unique
  prId                String
  pr                  PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  title               String
  scope               String?
  terms               String?
  deliveryRequirement String?
  responseDeadline    DateTime

  /// DRAFT | ISSUED | RESPONSES_IN | CLOSED | CANCELLED | AWARDED
  status      String    @default("DRAFT")
  createdById String
  createdBy   User      @relation("RfqCreatedBy", fields: [createdById], references: [id])
  issuedAt    DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  vendors        RfqVendor[]
  quotes         VendorQuote[]
  comparatives   Comparative[]
  purchaseOrders PurchaseOrder[]

  negotiationMinutes NegotiationMinute[]
  workOrders WorkOrder[]
  @@index([prId])
  @@map("rfqs")

  /// ── Amendment, cancellation and reissue ─────────────────────────────────
  ///
  /// A quotation received against version 1 of a scope is not a quotation for
  /// version 2, so an amended RFQ has to say which version each quote answered.
  revisionVersion     Int     @default(1)
  amendmentCount      Int     @default(0)
  lastAmendmentReason String?
  cancelledAt         DateTime?
  cancelReason        String?
  /// Where this RFQ replaces a cancelled one, so the second attempt is visibly
  /// a second attempt rather than an unrelated enquiry.
  reissueOfRfqId      String?
  reissueOf           Rfq?    @relation("RfqReissue", fields: [reissueOfRfqId], references: [id])
  reissues            Rfq[]   @relation("RfqReissue")
}

model RfqVendor {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// INVITED | ACKNOWLEDGED | QUOTED | DECLINED | NO_RESPONSE
  status       String    @default("INVITED")
  invitedAt    DateTime  @default(now())
  respondedAt  DateTime?
  contactEmail String?

  /// EMAIL | PORTAL | WHATSAPP | PHYSICAL | SKYPE | WALK_IN
  channel String  @default("EMAIL")
  notes   String?

  @@unique([rfqId, vendorId])
  @@map("rfq_vendors")
}

model VendorQuote {
  id         String    @id @default(cuid())
  number     String    @unique
  rfqId      String
  rfq        Rfq       @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorId   String
  vendor     Vendor    @relation(fields: [vendorId], references: [id])
  quoteRef   String?
  quoteDate  DateTime  @default(now())
  validUntil DateTime?
  currency   String    @default("PKR")

  subtotal        Float @default(0)
  taxAmount       Float @default(0)
  deliveryCharges Float @default(0)
  otherCharges    Float @default(0)
  discount        Float @default(0)
  total           Float @default(0)

  taxRegistered  Boolean @default(true)
  deliveryDays   Int?
  paymentTerms   String?
  creditDays     Int?
  warrantyMonths Int?
  warrantyTerms  String?

  /// COMPLIANT | PARTIAL | NON_COMPLIANT | NOT_ASSESSED
  technicalCompliance String  @default("NOT_ASSESSED")
  complianceNotes     String?
  exceptions          String?
  notes               String?

  /// DRAFT | SUBMITTED | UNDER_REVIEW | SHORTLISTED | SELECTED | REJECTED | EXPIRED
  status String @default("SUBMITTED")

  /// EMAIL | PORTAL | WHATSAPP | PHYSICAL | SKYPE | WALK_IN
  channel     String   @default("EMAIL")
  enteredById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items            QuoteItem[]
  negotiations     Negotiation[]
  comparativeLines ComparativeLine[]
  purchaseOrders   PurchaseOrder[]

  @@unique([rfqId, vendorId])
  @@map("vendor_quotes")

  /// The RFQ version this quotation answered. An amendment after quotes are in
  /// leaves them answering a scope that has changed, and a comparative that
  /// mixes versions is comparing different questions.
  rfqVersion Int @default(1)
}

model QuoteItem {
  id            String                   @id @default(cuid())
  quoteId       String
  quote         VendorQuote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  prItemId      String?
  prItem        PurchaseRequisitionItem? @relation(fields: [prItemId], references: [id])
  itemId        String?
  item          Item?                    @relation(fields: [itemId], references: [id])
  lineNo        Int
  description   String
  brand         String?
  model         String?
  specification String?
  quantity      Float
  unit          String
  unitPrice     Float
  taxRate       Float                    @default(0)
  taxAmount     Float                    @default(0)
  lineTotal     Float                    @default(0)
  deliveryDays  Int?

  /// COMPLIANT | PARTIAL | NON_COMPLIANT | NOT_ASSESSED
  compliance String  @default("NOT_ASSESSED")
  notes      String?

  @@unique([quoteId, lineNo])
  @@map("quote_items")
}

model Comparative {
  id     String              @id @default(cuid())
  number String              @unique
  prId   String
  pr     PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  rfqId  String
  rfq    Rfq                 @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  /// DRAFT | UNDER_REVIEW | RECOMMENDED | APPROVED | REJECTED | SUPERSEDED
  status       String   @default("DRAFT")
  preparedById String
  preparedAt   DateTime @default(now())

  recommendedQuoteId  String?
  recommendationBasis String?

  /// Justification required when the recommended quote is not the lowest compliant
  nonLowestJustification String?
  evaluationCriteria     String  @default("[]")

  marketPrice    Float?
  previousPrice  Float?
  lowestTotal    Float?
  selectedTotal  Float?
  savingsAmount  Float    @default(0)
  savingsPercent Float    @default(0)
  notes          String?

  /// The Cost Analysis Form the comparative is signed off on.
  ///
  /// Every field here is a question the paper form asks and the record could not
  /// previously answer: who the requisition's point of contact was, which legal
  /// entity the invoice is charged to, and the four compliance questions that
  /// decide whether an award above the lowest quotation is defensible.
  pocUserId       String?
  pocUser         User?   @relation("ComparativePoc", fields: [pocUserId], references: [id])
  taxPercent      Float   @default(16)
  invoiceChargedTo String?
  awardedToVendorId String?
  awardedToVendor   Vendor? @relation("ComparativeAwardedTo", fields: [awardedToVendorId], references: [id])
  specialNotes    String?
  remarks         String?

  /// The four questions on the form. Null means nobody has answered yet, which
  /// is not the same as "no" and blocks sign-off rather than passing quietly.
  singleSourced        Boolean?
  ratesLocked          Boolean?
  vendorSelectionForm  Boolean?
  higherRateReason     String?

  /// Prepared by is already `preparedById`; a form is only complete once a
  /// second person has verified it, which is what the paper signature block is.
  verifiedById String?
  verifiedBy   User?     @relation("ComparativeVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  updatedAt      DateTime @updatedAt

  lines          ComparativeLine[]
  manualEntries  ComparativeManualEntry[]
  cpcCases       CpcCase[]
  savingsRecords SavingsRecord[]

  workOrders WorkOrder[]
  priceCompetitiveness PriceCompetitivenessReview?
  @@index([prId])
  @@map("comparatives")
}

model ComparativeLine {
  id            String      @id @default(cuid())
  comparativeId String
  comparative   Comparative @relation(fields: [comparativeId], references: [id], onDelete: Cascade)
  quoteId       String
  quote         VendorQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  vendorId      String
  vendor        Vendor      @relation(fields: [vendorId], references: [id])

  unitPriceAvg        Float   @default(0)
  subtotal            Float   @default(0)
  taxAmount           Float   @default(0)
  deliveryCharges     Float   @default(0)
  total               Float   @default(0)
  negotiatedTotal     Float?
  netTotal            Float   @default(0)
  previousPrice       Float?
  marketPrice         Float?
  variancePercent     Float?
  deliveryDays        Int?
  paymentTerms        String?
  warrantyMonths      Int?
  technicalCompliance String  @default("NOT_ASSESSED")
  vendorScore         Float?
  vendorOnTimePercent Float?
  isLowest            Boolean @default(false)
  isLowestCompliant   Boolean @default(false)
  isSelected          Boolean @default(false)
  rank                Int?
  scoreTotal          Float?
  scoreBreakdown      String?
  notes               String?

  /// The per-vendor terms grid at the foot of the Cost Analysis Form. Payment
  /// terms and delivery days are already held above; these are the two the form
  /// asks for that nothing recorded.
  specifications   String?
  taxInformation   String?
  deliveryCommitment String?

  @@unique([comparativeId, quoteId])
  @@map("comparative_lines")
}

model Negotiation {
  id              String      @id @default(cuid())
  quoteId         String
  quote           VendorQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  round           Int
  originalTotal   Float
  negotiatedTotal Float
  finalTotal      Float?
  savings         Float       @default(0)
  savingsPercent  Float       @default(0)

  /// CALL | EMAIL | MEETING | WHATSAPP | PORTAL
  channel        String   @default("CALL")
  negotiatedById String
  negotiatedBy   User     @relation(fields: [negotiatedById], references: [id])
  negotiatedAt   DateTime @default(now())
  notes          String?

  /// OPEN | ACCEPTED | REJECTED | VENDOR_DECLINED
  outcome String @default("OPEN")

  @@unique([quoteId, round])
  @@map("negotiations")
}

// ─────────────────────────────────────────────────────────────
// CPC
// ─────────────────────────────────────────────────────────────

model CpcMeeting {
  id          String   @id @default(cuid())
  number      String   @unique
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  title       String
  scheduledAt DateTime

  /// WEEKLY | ON_DEMAND
  meetingType String  @default("WEEKLY")
  location    String?

  /// SCHEDULED | IN_PROGRESS | COMPLETED | CANCELLED
  status    String   @default("SCHEDULED")
  agenda    String?
  minutes   String?
  createdAt DateTime @default(now())

  cases CpcCase[]

  @@map("cpc_meetings")
}

model CpcCase {
  id             String              @id @default(cuid())
  number         String              @unique
  prId           String
  pr             PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  comparativeId  String?
  comparative    Comparative?        @relation(fields: [comparativeId], references: [id])
  meetingId      String?
  meeting        CpcMeeting?         @relation(fields: [meetingId], references: [id])
  title          String
  amount         Float               @default(0)
  savingsAmount  Float               @default(0)
  recommendation String?
  riskNotes      String?

  /// PENDING | SCHEDULED | UNDER_REVIEW | PENDING_CEO | APPROVED | REJECTED | RETURNED | CLARIFICATION | DEFERRED
  ///
  /// PENDING_CEO is where a case the committee has approved waits for the Office
  /// of the CEO. It is a distinct state rather than a flag on APPROVED, because
  /// the difference matters downstream: an approved case releases the requisition
  /// to purchase order preparation, and one still waiting on the CEO must not.
  status    String    @default("PENDING")
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  /// ── PC-023 · the Office of the CEO ──────────────────────────────────────
  ///
  /// "All purchases above PKR 1,500,000 are to be approved by Office of CEO."
  /// The requirement was computed and put in a sentence on screen, and nothing
  /// read it — so a case over the tier announced that the CEO must approve it
  /// and then approved without them.
  ///
  /// Snapshotted at case creation. The threshold is configuration and moves; a
  /// case decided under the old tier must not be retrospectively found wanting,
  /// and one raised above the tier must not escape by the tier being lifted.
  ceoApprovalRequired  Boolean   @default(false)
  ceoThresholdAtRaise  Float?
  ceoDecision          String?
  ceoDecidedById       String?
  ceoDecidedBy         User?     @relation("CpcCeoDecision", fields: [ceoDecidedById], references: [id])
  ceoDecidedAt         DateTime?
  ceoComment           String?

  /// ── CP-006 · quorum, snapshotted at the decision ────────────────────────
  ///
  /// "At least 3 permanent committee members present in addition to the Head of
  /// the requisitioner department." The roster moves; whether *this* case was
  /// quorate must stay answerable, so the figures are written onto the case.
  quorumRequired          Int?
  quorumPresent           Int?
  requisitionerHeadPresent Boolean @default(false)
  deferredReason          String?

  /// ── CP-016 · the decision mechanism ─────────────────────────────────────
  ///
  /// "Once quorum finalises a decision, HOD Procurement shares it." The vote is
  /// not the end of it — the decision has to reach the people who act on it, and
  /// a committee decision nobody was told of cannot be acted on.
  decisionCircularRef    String?
  decisionCirculatedAt   DateTime?
  /// CP-016 names the Office of the CEO on copy, exactly as RN-010 does for the
  /// rental committee. Held as its own fact because "circulated" and "circulated
  /// to the people the clause names" are different claims.
  decisionCeoOfficeCopied Boolean @default(false)
  decisionCirculatedById String?
  decisionCirculatedBy   User?     @relation("CpcDecisionCirculatedBy", fields: [decisionCirculatedById], references: [id])

  members    CpcCaseMember[]
  decisions  CpcDecision[]
  attendance CpcAttendance[]

  @@index([status])
  @@map("cpc_cases")
}

model CpcCaseMember {
  id        String  @id @default(cuid())
  caseId    String
  case      CpcCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  roleLabel String
  required  Boolean @default(true)

  @@unique([caseId, userId])
  @@map("cpc_case_members")
}

model CpcDecision {
  id       String  @id @default(cuid())
  caseId   String
  case     CpcCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  memberId String
  member   User    @relation(fields: [memberId], references: [id])

  /// APPROVE | REJECT | RETURN | REQUEST_CLARIFICATION | ABSTAIN
  vote      String
  comment   String?
  decidedAt DateTime @default(now())

  /// Final consolidated decision flag
  isFinal Boolean @default(false)

  @@map("cpc_decisions")
}

// ─────────────────────────────────────────────────────────────
// PURCHASE ORDERS
// ─────────────────────────────────────────────────────────────

model PurchaseOrder {
  id       String               @id @default(cuid())
  number   String               @unique
  entityId String
  entity   Entity               @relation(fields: [entityId], references: [id])
  prId     String?
  pr       PurchaseRequisition? @relation(fields: [prId], references: [id])
  rfqId    String?
  rfq      Rfq?                 @relation(fields: [rfqId], references: [id])
  quoteId  String?
  quote    VendorQuote?         @relation(fields: [quoteId], references: [id])
  vendorId String
  vendor   Vendor               @relation(fields: [vendorId], references: [id])

  vendorAddress   String?
  vendorContact   String?
  deliveryStoreId String?
  deliveryStore   Store?    @relation(fields: [deliveryStoreId], references: [id])
  deliveryAddress String?
  deliveryDate    DateTime?
  paymentTerms    String?
  creditDays      Int?
  warrantyTerms   String?
  termsConditions String?
  incoterms       String?

  currency        String @default("PKR")
  subtotal        Float  @default(0)
  taxAmount       Float  @default(0)
  serviceAcceptances ServiceAcceptance[]
  /// GOODS | SERVICES
  ///
  /// Orthogonal to `procurementType`, which mixes cadence with kind — SERVICE
  /// sits there beside ON_DEMAND, so a monthly requisition for grocery and a
  /// monthly requisition for cleaning could not be told apart. This says which
  /// of the two procurement treatments applies, and nothing else.
  ///
  /// Goods take the receiving path: gate pass, delivery, inspection, GRN,
  /// inventory. Services take service acceptance and never touch inventory.
  procurementKind String @default("GOODS")

  /// The policy that governed this transaction, snapshotted at the point of
  /// decision. A later change to configuration must never rewrite what was
  /// decided under the old rules.
  policyDocument String? @default("ZAM/PUR/SOP-01")
  policyVersion  String? @default("01")
  /// JSON: the effective configuration values that applied.
  policySnapshot String?

  deliveryCharges Float  @default(0)
  otherCharges    Float  @default(0)
  discount        Float  @default(0)
  total           Float  @default(0)

  advanceRequired Boolean @default(false)
  advanceAmount   Float?
  advancePercent  Float?
  advanceStatus   String?
  collateralType  String?
  collateralRef   String?
  collateralNotes String?

  /// DRAFT | PENDING_APPROVAL | APPROVED | ISSUED | PARTIALLY_RECEIVED | FULLY_RECEIVED | CLOSED | CANCELLED | ON_HOLD
  status        String    @default("DRAFT")
  closureReason String?
  createdById   String
  createdBy     User      @relation("PoCreatedBy", fields: [createdById], references: [id])
  approvedAt    DateTime?
  issuedAt      DateTime?
  closedAt      DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items          PurchaseOrderItem[]
  gatePasses     GatePass[]
  deliveries     Delivery[]
  grns           Grn[]
  invoices       Invoice[]
  inspections    Inspection[]
  exceptions     Exception[]
  savingsRecords SavingsRecord[]

  allocations PrPoAllocation[]

  variances       PoVariance[]
  returns         VendorReturn[]
  matches         ThreeWayMatch[]
  /// CAPEX | OPEX, carried from the requisition it serves.
  expenditureType String          @default("OPEX")
  costCenterId    String?

  serialUnits SerialUnit[]
  /// ── §4.6 · issuance and acknowledgement ──────────────────────────────────
  ///
  /// "Procurement department will solely be authorized to issue purchase order,
  /// contract, agreement or any other related documents ... **with the signature
  /// of Manager Procurement or other authorized signatory** to the vendor."
  ///
  /// The order recorded who created it and when it was issued, and nothing about
  /// who signed it or whether the vendor ever saw it.
  authorisedSignatoryId String?
  authorisedSignatory   User?     @relation("PoAuthorisedSignatory", fields: [authorisedSignatoryId], references: [id])
  signedAt              DateTime?

  /// How the order reached the vendor, and the evidence that it did. An order
  /// nobody can show was sent is an order the vendor can deny receiving.
  /// EMAIL | PORTAL | COURIER | HAND | WHATSAPP
  distributionChannel String?
  distributedAt       DateTime?
  distributionRef     String?

  /// PENDING — issued, nothing heard.
  /// ACKNOWLEDGED — the vendor confirmed the order.
  /// REJECTED — the vendor declined it.
  /// NO_RESPONSE — the acknowledgement window passed in silence. Distinct from
  ///   PENDING: one is waiting, the other is a fact about the vendor.
  /// DEEMED_ACCEPTED_THROUGH_EXECUTION — no acknowledgement was ever given, but
  ///   the vendor delivered against it. Recorded honestly rather than
  ///   backdated into ACKNOWLEDGED, because what happened is that somebody
  ///   performed without confirming.
  acknowledgementStatus String    @default("PENDING")
  acknowledgedAt        DateTime?
  acknowledgedByName    String?
  acknowledgementNotes  String?
  /// When silence becomes NO_RESPONSE.
  acknowledgementDueAt  DateTime?
  @@index([status])
  @@index([vendorId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String                   @id @default(cuid())
  poId          String
  po            PurchaseOrder            @relation(fields: [poId], references: [id], onDelete: Cascade)
  lineNo        Int
  itemId        String?
  item          Item?                    @relation(fields: [itemId], references: [id])
  prItemId      String?
  prItem        PurchaseRequisitionItem? @relation(fields: [prItemId], references: [id])
  description   String
  brand         String?
  model         String?
  specification String?
  quantity      Float
  unit          String
  unitPrice     Float
  taxRate       Float                    @default(0)
  taxAmount     Float                    @default(0)
  lineTotal     Float                    @default(0)

  /// INVENTORY | CONSUMABLE | EXPENSE | ASSET | PROJECT_MATERIAL
  disposition        String  @default("INVENTORY")
  /// GOODS | SERVICES. A goods order must not silently carry a service line.
  procurementKind String @default("GOODS")

  /// The tax rule applied to this line, and a snapshot of it.
  ///
  /// Goods and services can carry different taxes, so tax is a line-level
  /// concern. The snapshot is what makes a historical order stay correct after
  /// the Tax Master changes: the percentage that was applied is stored here, not
  /// looked up again at read time.
  taxRuleId       String?
  taxRule         TaxRule? @relation(fields: [taxRuleId], references: [id])
  /// JSON: { code, name, percent, withholding, appliesTo, effectiveFrom }
  taxRuleSnapshot String?
  serviceAcceptanceItems ServiceAcceptanceItem[]

  requiresInspection Boolean @default(false)

  receivedQty Float @default(0)
  acceptedQty Float @default(0)
  rejectedQty Float @default(0)
  invoicedQty Float @default(0)

  deliveryItems   DeliveryItem[]
  grnItems        GrnItem[]
  invoiceItems    InvoiceItem[]
  inspectionItems InspectionItem[]

  allocations PrPoAllocation[]

  @@unique([poId, lineNo])
  @@map("purchase_order_items")
}

// ─────────────────────────────────────────────────────────────
// GATE PASS / DELIVERY / INSPECTION / GRN
// ─────────────────────────────────────────────────────────────

model GatePass {
  id     String @id @default(cuid())
  number String @unique
  serial String @unique

  /// INWARD | OUTWARD
  direction String         @default("INWARD")
  poId      String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  vendorId  String?
  vendor    Vendor?        @relation(fields: [vendorId], references: [id])
  storeId   String
  store     Store          @relation(fields: [storeId], references: [id])

  vehicleNumber       String?
  vehicleType         String?
  driverName          String?
  driverCnic          String?
  driverPhone         String?
  deliveryNoteRef     String?
  invoiceRef          String?
  materialSummary     String?
  declaredQuantity    Float?
  declaredPackages    Int?
  securityCheckedById String?
  securityRemarks     String?
  recordedById        String
  recordedBy          User      @relation("GatePassRecordedBy", fields: [recordedById], references: [id])
  arrivedAt           DateTime  @default(now())
  releasedAt          DateTime?

  /// RECORDED | ROUTED_TO_STORE | RECEIVED | CLOSED | REJECTED
  status    String   @default("RECORDED")
  createdAt DateTime @default(now())

  deliveries Delivery[]
  grns       Grn[]

  @@index([poId])
  @@map("gate_passes")
}

model Delivery {
  id              String        @id @default(cuid())
  number          String        @unique
  poId            String
  po              PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  gatePassId      String?
  gatePass        GatePass?     @relation(fields: [gatePassId], references: [id])
  vendorId        String
  vendor          Vendor        @relation(fields: [vendorId], references: [id])
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id])
  deliveryNoteRef String?
  deliveryDate    DateTime      @default(now())
  receivedById    String
  receivedBy      User          @relation("DeliveryReceivedBy", fields: [receivedById], references: [id])

  totalPackages         Int?
  packagesVerified      Int?
  packagingCondition    String?
  physicalCondition     String?
  damageObserved        Boolean @default(false)
  damageNotes           String?
  leakageObserved       Boolean @default(false)
  handlingNotes         String?
  weightRecorded        Float?
  weightUnit            String?
  documentationComplete Boolean @default(true)

  /// PENDING_VERIFICATION | ACCEPTED | PARTIALLY_ACCEPTED | REJECTED | ACCEPTED_WITH_DISCREPANCY
  status    String   @default("PENDING_VERIFICATION")
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       DeliveryItem[]
  inspections Inspection[]
  grns        Grn[]

  rejections RejectionRecord[]

  @@index([poId])
  @@map("deliveries")
}

model DeliveryItem {
  id         String            @id @default(cuid())
  deliveryId String
  delivery   Delivery          @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  poItemId   String
  poItem     PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  itemId     String?
  item       Item?             @relation(fields: [itemId], references: [id])
  lineNo     Int

  description   String
  orderedQty    Float
  expectedQty   Float
  actualQty     Float
  acceptedQty   Float     @default(0)
  rejectedQty   Float     @default(0)
  unit          String
  packages      Int?
  batchNumber   String?
  serialNumbers String?
  expiryDate    DateTime?

  warrantyMonths     Int?
  specificationMatch Boolean @default(true)
  conditionNotes     String?

  /// ── RC-003 · bulk receipts, box by box ──────────────────────────────────
  ///
  /// "For bulk receipts, packing method verified and each box checked against
  /// delivery documents." A package count on its own does not say that: eighteen
  /// packages received tells you nothing about whether anyone opened them.
  ///
  /// So the check is its own fact. `boxesChecked` against `packages` is the
  /// coverage, and a bulk line where they differ is a line somebody signed for
  /// without looking — which is the practice the clause exists to stop.
  packingMethodVerified Boolean @default(false)
  boxesChecked          Int?
  boxCheckNotes         String?
  boxesWithDiscrepancy  Int?

  /// OK | QUANTITY_MISMATCH | DAMAGED | WRONG_ITEM | WRONG_SPEC | EXPIRED | MISSING_SERIAL | MISSING_WARRANTY | SHORT_DELIVERY | EXCESS_DELIVERY
  discrepancyType  String  @default("OK")
  discrepancyNotes String?

  @@unique([deliveryId, lineNo])
  @@map("delivery_items")
}

model Inspection {
  id         String         @id @default(cuid())
  number     String         @unique
  poId       String?
  po         PurchaseOrder? @relation(fields: [poId], references: [id])
  deliveryId String?
  delivery   Delivery?      @relation(fields: [deliveryId], references: [id])

  /// IT | MECHANICAL | CIVIL | ELECTRICAL | GENERAL | QUALITY
  inspectionType String    @default("GENERAL")
  templateCode   String?
  inspectorId    String?
  inspector      User?     @relation("InspectionInspector", fields: [inspectorId], references: [id])
  department     String?
  scheduledAt    DateTime?
  inspectedAt    DateTime?

  /// PENDING | IN_PROGRESS | APPROVED | REJECTED | CONDITIONAL | RE_INSPECTION_REQUIRED
  result       String    @default("PENDING")
  findings     String?
  conditions   String?
  signedByName String?
  signedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items InspectionItem[]
  grns  Grn[]

  rejections RejectionRecord[]

  signoffs InspectionSignoff[]
  vendorReturns VendorReturn[]
  /// Annexure 4's header. The receiving date is when the goods arrived, which is
  /// not the same day the inspection happened and the form prints both.
  receivedDate DateTime?
  /// Which department's POC has to sign the second block. Resolved from the
  /// requisition at scheduling and held, so a later reorganisation does not
  /// change who was supposed to have signed.
  concernedDepartmentId String?
  concernedPocId        String?
  @@index([deliveryId])
  @@map("inspections")
}

model InspectionItem {
  id           String             @id @default(cuid())
  inspectionId String
  inspection   Inspection         @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  poItemId     String?
  poItem       PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  itemId       String?
  item         Item?              @relation(fields: [itemId], references: [id])
  lineNo       Int
  description  String

  quantityInspected   Float   @default(0)
  quantityPassed      Float   @default(0)
  quantityFailed      Float   @default(0)
  serialNumber        String?
  modelVerified       String?
  specVerified        String?
  configuration       String?
  condition           String?
  performanceNotes    String?
  accessoriesComplete Boolean @default(true)

  /// PASS | FAIL | CONDITIONAL
  verdict String @default("PASS")

  /// JSON criterion results
  criteriaResults String  @default("[]")
  notes           String?

  /// Annexure 4 prints an expiry column. Held on the inspection line rather than
  /// read off the stock bucket, because the inspection happens before the goods
  /// are taken into inventory — there is no bucket to read yet.
  expiryDate DateTime?
  @@unique([inspectionId, lineNo])
  @@map("inspection_items")
}

model Grn {
  id           String        @id @default(cuid())
  number       String        @unique
  poId         String
  po           PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  vendorId     String
  vendor       Vendor        @relation(fields: [vendorId], references: [id])
  deliveryId   String?
  delivery     Delivery?     @relation(fields: [deliveryId], references: [id])
  gatePassId   String?
  gatePass     GatePass?     @relation(fields: [gatePassId], references: [id])
  inspectionId String?
  inspection   Inspection?   @relation(fields: [inspectionId], references: [id])
  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])
  receivedById String
  receivedBy   User          @relation("GrnReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime      @default(now())

  /// DRAFT | POSTED | CANCELLED
  status String @default("DRAFT")

  /// NOT_REQUIRED | PENDING | APPROVED | REJECTED | CONDITIONAL
  inspectionStatus String    @default("NOT_REQUIRED")
  totalValue       Float     @default(0)
  remarks          String?
  postedAt         DateTime?
  /// Who committed the receipt to inventory.
  ///
  /// Distinct from `receivedById`, which is who took delivery. The segregation
  /// rule that keeps the three-way match independent needs the person whose act
  /// created the stock record, and that used to exist only in the audit trail —
  /// so the rule had to settle for the receiver.
  postedById       String?
  postedBy         User?     @relation("GrnPostedBy", fields: [postedById], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  items          GrnItem[]
  transactions   InventoryTransaction[]
  invoiceMatches InvoiceGrnLink[]
  stacking       GoodsStacking[]
  assets         Asset[]

  variances       PoVariance[]
  returns         VendorReturn[]
  matches         ThreeWayMatch[]
  rejections      RejectionRecord[]
  /// CAPEX | OPEX, carried from the order.
  expenditureType String            @default("OPEX")

  serialUnits SerialUnit[]
  @@index([poId])
  @@map("grns")
}

model GrnItem {
  id          String            @id @default(cuid())
  grnId       String
  grn         Grn               @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItemId    String
  poItem      PurchaseOrderItem @relation(fields: [poItemId], references: [id])
  itemId      String?
  item        Item?             @relation(fields: [itemId], references: [id])
  lineNo      Int
  description String

  orderedQty  Float
  receivedQty Float
  acceptedQty Float
  rejectedQty Float  @default(0)
  unit        String
  unitPrice   Float  @default(0)
  lineValue   Float  @default(0)

  batchNumber     String?
  serialNumbers   String?
  expiryDate      DateTime?
  warrantyMonths  Int?
  storeLocationId String?
  disposition     String    @default("INVENTORY")

  /// The treatment the item or its category says by default, kept so an override
  /// is visible as an override rather than having to be inferred later.
  defaultDisposition String?

  /// Why this line departs from its default, and who approved the departure.
  ///
  /// The same air conditioner is an office asset and a project cost, so the
  /// decision belongs to the receipt. What makes it reviewable rather than
  /// arbitrary is the reason and the approval — particularly for capitalising
  /// below the threshold, which the policy allows only with both.
  treatmentReason       String?
  treatmentApprovedById String?
  treatmentApprovedBy   User?     @relation("GrnTreatmentApprover", fields: [treatmentApprovedById], references: [id])
  treatmentApprovedAt   DateTime?

  /// True when the line capitalises below the configured threshold. Stored
  /// rather than recomputed, because the threshold moves and this is the fact
  /// about the decision as it was taken.
  capitalisedBelowThreshold Boolean @default(false)

  /// Where the goods went, which is what makes the treatment defensible.
  usageContext String?
  remarks         String?

  @@unique([grnId, lineNo])
  @@map("grn_items")
}

model GoodsStacking {
  id          String         @id @default(cuid())
  grnId       String?
  grn         Grn?           @relation(fields: [grnId], references: [id])
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id])
  locationId  String?
  location    StoreLocation? @relation(fields: [locationId], references: [id])
  itemId      String?
  item        Item?          @relation(fields: [itemId], references: [id])
  description String
  quantity    Float
  unit        String

  /// PALLET | RACK | SHELF | FLOOR | BULK | CAGE | COLD_STORAGE
  stackingMethod String @default("RACK")

  /// GENERAL | HIGH_VALUE | SENSITIVE | HAZARDOUS | PROJECT_MATERIAL
  goodsClass           String   @default("GENERAL")
  handlingRequirements String?

  /// RC-016 — the stacking category applied, snapshotted from the item at the
  /// time of stacking. Held on the row because a later reclassification of the
  /// item must not rewrite where this consignment was actually put.
  stackingCategoryId String?
  stackingCategory   StackingCategory? @relation(fields: [stackingCategoryId], references: [id])
  stackedById          String
  stackedBy            User     @relation("StackedBy", fields: [stackedById], references: [id])
  stackedAt            DateTime @default(now())
  notes                String?

  @@map("goods_stacking")
}

// ─────────────────────────────────────────────────────────────
// INVENTORY / STORES
// ─────────────────────────────────────────────────────────────

model InventoryItem {
  id           String         @id @default(cuid())
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id])
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id])
  locationId   String?
  location     StoreLocation? @relation(fields: [locationId], references: [id])
  projectId    String?
  project      Project?       @relation(fields: [projectId], references: [id])
  batchNumber  String?
  serialNumber String?
  expiryDate   DateTime?

  quantity    Float  @default(0)
  reservedQty Float  @default(0)
  unit        String
  unitCost    Float  @default(0)
  totalValue  Float  @default(0)

  warrantyMonths Int?
  warrantyUntil  DateTime?
  lastGrnId      String?
  lastPoId       String?
  entityId       String?
  updatedAt      DateTime  @updatedAt

  @@unique([itemId, storeId, batchNumber, serialNumber])
  @@index([storeId])
  @@index([itemId])
  @@map("inventory")
}

model InventoryTransaction {
  id      String @id @default(cuid())
  number  String @unique
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  /// RECEIPT | ISSUE | TRANSFER_OUT | TRANSFER_IN | ADJUSTMENT | RETURN | DISPOSAL | RESERVATION | RELEASE
  type         String
  quantity     Float
  unit         String
  unitCost     Float   @default(0)
  value        Float   @default(0)
  balanceAfter Float   @default(0)
  batchNumber  String?
  serialNumber String?

  /// GRN | ISSUE | TRANSFER | DISPOSAL | ADJUSTMENT | PETTY_CASH | REQUIREMENT
  sourceType  String
  sourceId    String?
  sourceRef   String?
  grnId       String?
  grn         Grn?              @relation(fields: [grnId], references: [id])
  issueId     String?
  issue       StoreIssue?       @relation(fields: [issueId], references: [id])
  transferId  String?
  transfer    StoreTransfer?    @relation(fields: [transferId], references: [id])
  disposalId  String?
  disposal    DisposalCase?     @relation(fields: [disposalId], references: [id])
  pettyCashId String?
  pettyCash   PettyCashRequest? @relation(fields: [pettyCashId], references: [id])
  reason      String?

  performedById String
  performedAt   DateTime @default(now())

  /// What FIFO says this movement cost, when cost layers covered it.
  /// Null on every row posted before layers began and on any movement the
  /// layers could not fully cover — a null is "not computed", which is not
  /// the same claim as zero.
  fifoValue     Float?
  fifoUnitCost  Float?
  /// WEIGHTED_AVERAGE | FIFO — which figure `value` above was taken from.
  costingMethod String?
  @@index([itemId, storeId])
  @@index([sourceType, sourceId])
  @@map("inventory_transactions")
}

model StoreIssue {
  id            String @id @default(cuid())
  number        String @unique
  storeId       String
  store         Store  @relation(fields: [storeId], references: [id])
  requestedById String
  requestedBy   User   @relation("IssueRequestedBy", fields: [requestedById], references: [id])

  recipientName   String
  recipientUserId String?
  departmentId    String?
  projectId       String?
  purpose         String?

  /// DRAFT | SUBMITTED | PENDING_DEPARTMENT_APPROVAL | PENDING_HOD_APPROVAL
  /// | PENDING_CROSS_STORE_APPROVAL | APPROVED | REJECTED | RETURNED
  /// | PARTIALLY_ISSUED | ISSUED | CLOSED | CANCELLED
  status      String    @default("DRAFT")
  requestedAt DateTime  @default(now())
  submittedAt DateTime?

  /// Department head, then the store's own authority — two distinct decisions,
  /// because the person who owns the budget is rarely the person who owns the
  /// shelf.
  departmentApprovedById String?
  departmentApprovedAt   DateTime?
  hodApprovedById        String?
  hodApprovedAt          DateTime?

  approvedAt   DateTime?
  issuedAt     DateTime?
  issuedById   String?
  closedAt     DateTime?
  remarks      String?
  returnReason String?
  rejectReason String?

  /// The requirement this fulfils, when it came through the front door rather
  /// than being raised directly at a store.
  requirementId String?
  requirement   Requirement? @relation(fields: [requirementId], references: [id])

  /// Stock found in another store. A store user works their own store by
  /// default, so drawing on someone else's needs its own approval.
  sourceStoreId          String?
  sourceStore            Store?    @relation("IssueSourceStore", fields: [sourceStoreId], references: [id])
  crossStoreApprovedById String?
  crossStoreApprovedAt   DateTime?

  items        StoreIssueItem[]
  transactions InventoryTransaction[]
  reservations InventoryReservation[]

  @@map("store_issues")
}

model StoreIssueItem {
  id      String     @id @default(cuid())
  issueId String
  issue   StoreIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  itemId  String
  item    Item       @relation(fields: [itemId], references: [id])
  lineNo  Int

  requestedQty      Float
  approvedQty       Float?
  issuedQty         Float   @default(0)
  unit              String
  availableQty      Float   @default(0)
  assetId           String?
  assetTag          String?
  custodianUserId   String?
  serialNumber      String?
  batchNumber       String?
  notes             String?
  requirementItemId String?

  @@unique([issueId, lineNo])
  @@map("store_issue_items")
}

model StoreTransfer {
  id            String  @id @default(cuid())
  number        String  @unique
  fromStoreId   String
  fromStore     Store   @relation("TransferFrom", fields: [fromStoreId], references: [id])
  toStoreId     String
  toStore       Store   @relation("TransferTo", fields: [toStoreId], references: [id])
  requestedById String
  requestedBy   User    @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  reason        String?

  /// DRAFT | PENDING_APPROVAL | APPROVED | REJECTED | DISPATCHED | RECEIVED | CANCELLED
  status         String    @default("DRAFT")
  requestedAt    DateTime  @default(now())
  approvedAt     DateTime?
  dispatchedAt   DateTime?
  receivedAt     DateTime?
  dispatchedById String?
  receivedById   String?
  vehicleNumber  String?
  gatePassRef    String?
  remarks        String?

  items        StoreTransferItem[]
  transactions InventoryTransaction[]

  @@map("store_transfers")
}

model StoreTransferItem {
  id         String        @id @default(cuid())
  transferId String
  transfer   StoreTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item          @relation(fields: [itemId], references: [id])
  lineNo     Int

  requestedQty  Float
  dispatchedQty Float   @default(0)
  receivedQty   Float   @default(0)
  unit          String
  unitCost      Float   @default(0)
  batchNumber   String?
  serialNumber  String?
  notes         String?

  @@unique([transferId, lineNo])
  @@map("store_transfer_items")
}

// ─────────────────────────────────────────────────────────────
// INVOICES / FINANCE
// ─────────────────────────────────────────────────────────────

model Invoice {
  id                  String        @id @default(cuid())
  number              String        @unique
  vendorInvoiceNumber String
  poId                String
  po                  PurchaseOrder @relation(fields: [poId], references: [id])
  vendorId            String
  vendor              Vendor        @relation(fields: [vendorId], references: [id])
  invoiceDate         DateTime
  receivedDate        DateTime      @default(now())
  dueDate             DateTime?

  currency        String @default("PKR")
  subtotal        Float  @default(0)
  taxAmount       Float  @default(0)
  deliveryCharges Float  @default(0)
  otherCharges    Float  @default(0)
  discount        Float  @default(0)
  total           Float  @default(0)
  withholdingTax  Float  @default(0)
  netPayable      Float  @default(0)

  /// RECEIVED | UNDER_VERIFICATION | MATCHED | MISMATCH | EXCEPTION_APPROVED | PENDING_APPROVAL | APPROVED | SENT_TO_FINANCE | PAID | REJECTED | ON_HOLD
  status String @default("RECEIVED")

  /// PENDING | PASSED | FAILED | OVERRIDDEN
  matchStatus String  @default("PENDING")
  matchNotes  String?
  matchResult String  @default("{}")

  exceptionApprovedById String?
  exceptionApprovedAt   DateTime?
  exceptionReason       String?

  verifiedById String?
  verifiedBy   User?     @relation("InvoiceVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items      InvoiceItem[]
  grnLinks   InvoiceGrnLink[]
  handoffs   PaymentHandoff[]
  exceptions Exception[]

  vouchers Voucher[]
  matches  ThreeWayMatch[]
  taxLines InvoiceTaxLine[]

  @@index([status])
  @@index([poId])
  @@map("invoices")
}

model InvoiceItem {
  id          String             @id @default(cuid())
  invoiceId   String
  invoice     Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poItemId    String?
  poItem      PurchaseOrderItem? @relation(fields: [poItemId], references: [id])
  itemId      String?
  item        Item?              @relation(fields: [itemId], references: [id])
  lineNo      Int
  description String
  quantity    Float
  unit        String
  unitPrice   Float
  taxRate     Float              @default(0)
  taxAmount   Float              @default(0)
  lineTotal   Float              @default(0)

  /// OK | QTY_MISMATCH | PRICE_MISMATCH | NOT_ON_PO | NOT_RECEIVED | TAX_MISMATCH
  matchFlag      String  @default("OK")
  matchNotes     String?
  poQuantity     Float?
  poUnitPrice    Float?
  grnAcceptedQty Float?

  @@unique([invoiceId, lineNo])
  @@map("invoice_items")
}

model InvoiceGrnLink {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  grnId     String
  grn       Grn     @relation(fields: [grnId], references: [id])

  @@unique([invoiceId, grnId])
  @@map("invoice_grn_links")
}

model PaymentHandoff {
  id        String  @id @default(cuid())
  number    String  @unique
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String  @default("PKR")

  /// PENDING | ACKNOWLEDGED | SCHEDULED | PAID | REJECTED
  status String @default("PENDING")

  /// BANK_TRANSFER | CHEQUE | CASH | ONLINE
  paymentMethod    String?
  bankAccount      String?
  paymentReference String?
  scheduledDate    DateTime?
  paidDate         DateTime?
  handedOffById    String
  handedOffBy      User      @relation("HandoffBy", fields: [handedOffById], references: [id])
  handedOffAt      DateTime  @default(now())
  financeAckById   String?
  financeAckAt     DateTime?
  notes            String?

  voucherId String?
  voucher   Voucher? @relation(fields: [voucherId], references: [id])

  @@map("payment_handoffs")
}

// ─────────────────────────────────────────────────────────────
// PETTY CASH
// ─────────────────────────────────────────────────────────────

model PettyCashRequest {
  id           String     @id @default(cuid())
  number       String     @unique
  entityId     String
  entity       Entity     @relation(fields: [entityId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  requesterId  String
  requester    User       @relation("PettyCashRequester", fields: [requesterId], references: [id])

  purpose         String
  justification   String?
  estimatedAmount Float
  approvedAmount  Float?
  actualAmount    Float?
  currency        String    @default("PKR")
  requiredDate    DateTime?

  /// DRAFT | SUBMITTED | UNDER_EVALUATION | QUOTES_PENDING | QUOTES_COMPARED | PENDING_APPROVAL | APPROVED | PURCHASED | RECEIPT_UPLOADED | VOUCHER_GENERATED | VOUCHER_APPROVED | STORE_ENTRY_PENDING | STORE_ENTRY_DONE | RECONCILED | CLOSED | REJECTED | CANCELLED
  status String @default("DRAFT")

  /// INVENTORY | CONSUMABLE | EXPENSE | ASSET | PROJECT_MATERIAL
  disposition   String  @default("EXPENSE")
  storeRequired Boolean @default(false)
  storeId       String?

  storeEntryDoneAt    DateTime?
  purchasedAt         DateTime?
  purchasedFromVendor String?
  receiptRef          String?
  selectedQuoteId     String?
  evaluatedById       String?
  approvedById        String?
  approvedAt          DateTime?
  reconciledById      String?
  reconciledAt        DateTime?
  closedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  items        PettyCashItem[]
  quotes       PettyCashQuote[]
  vouchers     PettyCashVoucher[]
  transactions InventoryTransaction[]

  @@index([status])
  @@map("petty_cash_requests")
}

model PettyCashItem {
  id          String           @id @default(cuid())
  requestId   String
  request     PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  lineNo      Int
  itemId      String?
  item        Item?            @relation(fields: [itemId], references: [id])
  description String
  quantity    Float
  unit        String

  estimatedUnitPrice Float?
  actualUnitPrice    Float?
  lineTotal          Float  @default(0)

  /// INVENTORY | CONSUMABLE | EXPENSE | ASSET | PROJECT_MATERIAL
  disposition  String  @default("EXPENSE")
  storeEntered Boolean @default(false)

  @@unique([requestId, lineNo])
  @@map("petty_cash_items")
}

model PettyCashQuote {
  id        String           @id @default(cuid())
  requestId String
  request   PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  vendorName String
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])

  /// PHYSICAL | WHATSAPP | SKYPE | EMAIL | PHONE | WALK_IN
  channel      String   @default("PHYSICAL")
  contactRef   String?
  amount       Float
  taxIncluded  Boolean  @default(false)
  deliveryDays Int?
  notes        String?
  isSelected   Boolean  @default(false)
  quotedAt     DateTime @default(now())

  @@map("petty_cash_quotes")
}

model PettyCashVoucher {
  id        String           @id @default(cuid())
  number    String           @unique
  requestId String
  request   PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  amount    Float
  currency  String           @default("PKR")

  /// DRAFT | PENDING_SIGNATORY | APPROVED | REJECTED | RECONCILED
  status       String    @default("DRAFT")
  payeeName    String
  receiptRef   String?
  preparedById String
  preparedAt   DateTime  @default(now())
  signatoryId  String?
  signedAt     DateTime?
  notes        String?

  @@map("petty_cash_vouchers")
}

// ─────────────────────────────────────────────────────────────
// VENDORS
// ─────────────────────────────────────────────────────────────

model Vendor {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  legalName String?

  /// MANUFACTURER | DISTRIBUTOR | TRADER | SERVICE_PROVIDER | CONTRACTOR | RETAILER
  businessType  String  @default("DISTRIBUTOR")
  address       String?
  city          String?
  country       String  @default("Pakistan")
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  website       String?

  /// FILER | NON_FILER | EXEMPT | UNREGISTERED
  taxStatus          String    @default("FILER")
  ntn                String?
  strn               String?
  registrationNumber String?
  incorporationDate  DateTime?

  officeCount         Int?
  citiesCovered       String?
  workforceCount      Int?
  hasTransportation   Boolean @default(false)
  transportationNotes String?
  supportStaffCount   Int?
  paymentTerms        String?
  creditDays          Int?
  bankName            String?
  bankAccountTitle    String?
  bankAccountNumber   String?
  bankIban            String?
  references          String?
  productsServices    String?
  categories          String?

  /// INTERNET | REFERENCE | RELATIONSHIP | MEDIA | EMAIL | WALK_IN | MARKET | TENDER
  sourceChannel String  @default("MARKET")
  sourceNotes   String?

  /// Annexure 6 "Vendor Referred By".
  ///
  /// `sourceChannel` says a vendor came by reference; it cannot say by whose.
  /// The form asks, and the Internal Reference criterion scores points by the
  /// referrer's *designation* — so the designation is held here as it stood when
  /// the vendor was introduced, not looked up later from an office that may have
  /// changed.
  referredByName        String?
  referredByDesignation String?

  /// Annexure 6: "Any other company owned by same owner".
  ///
  /// A related-party question, and the one field on the form with real teeth:
  /// two names quoting against each other on the same comparative is not a
  /// comparison. Free text because the answer is a list of companies, and a
  /// vendor link would only capture the ones already registered — which is
  /// precisely not the case worth catching.
  relatedCompanies String?

  /// PROSPECT | UNDER_EVALUATION | PENDING_APPROVAL | APPROVED | CONDITIONAL | SUSPENDED | BLACKLISTED | INACTIVE
  status            String    @default("PROSPECT")
  statusReason      String?
  approvedAt        DateTime?
  blacklistedAt     DateTime?
  isTrader          Boolean   @default(false)
  minimumOrderValue Float?

  currentScore     Float?
  maxScore         Float?
  scorePercent     Float?
  performanceScore Float?
  onTimePercent    Float?
  qualityPercent   Float?
  rejectionPercent Float?
  totalOrders      Int       @default(0)
  totalSpend       Float     @default(0)
  lastOrderAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  entityLinks      VendorEntityLink[]
  documents        VendorDocument[]
  evaluations      VendorEvaluation[]
  performance      VendorPerformance[]
  issues           VendorIssue[]
  blacklistCases   VendorBlacklistCase[]
  rfqInvites       RfqVendor[]
  quotes           VendorQuote[]
  purchaseOrders   PurchaseOrder[]
  gatePasses       GatePass[]
  deliveries       Delivery[]
  grns             Grn[]
  invoices         Invoice[]
  priceHistory     PriceHistory[]
  assets           Asset[]
  pettyCashQuotes  PettyCashQuote[]
  disposalBids     DisposalBid[]
  contacts         VendorContact[]
  comparativeLines ComparativeLine[]
  comparativeAwards Comparative[]   @relation("ComparativeAwardedTo")

  returns VendorReturn[]

  manualComparativeEntries ComparativeManualEntry[]
  serialUnits SerialUnit[]
  negotiationMinutes NegotiationMinute[] 
  negotiationAppearances NegotiationParticipant[]
  workOrders WorkOrder[]
  contracts Contract[]
  @@index([status])
  @@map("vendors")

  buildOutScheduleDays BuildOutScheduleDay[]
}

model VendorEntityLink {
  vendorId String
  entityId String
  vendor   Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  approved Boolean @default(false)

  @@id([vendorId, entityId])
  @@map("vendor_entity_links")
}

model VendorContact {
  id        String  @id @default(cuid())
  vendorId  String
  vendor    Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  @@map("vendor_contacts")
}

model VendorDocument {
  id         String  @id @default(cuid())
  vendorId   String
  vendor     Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  documentId String?

  /// NTN_CERTIFICATE | STRN_CERTIFICATE | COMPANY_PROFILE | BANK_LETTER |
  /// INCORPORATION | REFERENCE_LETTER | ISO | OTHER |
  /// FBR_ONLINE_STATUS | JOB_COMPLETION_CERTIFICATE
  ///
  /// The last two are Annexure 6's mandatory documents, and neither had a home.
  /// FBR online status is a filer-status verification, which is not the NTN
  /// certificate; a job completion certificate from a client is not a reference
  /// letter. Folding either into its near neighbour would make the form's
  /// mandatory check pass on the wrong document.
  docType      String
  name         String
  expiryDate   DateTime?
  verified     Boolean   @default(false)
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())

  @@map("vendor_documents")
}

model EvaluationCriterion {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  maxScore    Float   @default(3)
  weight      Float   @default(1)
  group       String  @default("General")
  sequence    Int     @default(0)
  active      Boolean @default(true)

  scores VendorScore[]

  @@map("evaluation_criteria")
}

model VendorEvaluation {
  id       String @id @default(cuid())
  number   String @unique
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// PRE_QUALIFICATION | PERIODIC | POST_ISSUE | RE_EVALUATION
  evaluationType String   @default("PRE_QUALIFICATION")
  evaluatorId    String
  evaluator      User     @relation(fields: [evaluatorId], references: [id])
  evaluatedAt    DateTime @default(now())

  totalScore   Float   @default(0)
  maxScore     Float   @default(0)
  percentage   Float   @default(0)
  passingScore Float   @default(0)
  passed       Boolean @default(false)

  /// DRAFT | SUBMITTED | APPROVED | REJECTED
  status         String    @default("DRAFT")
  recommendation String?
  notes          String?
  approvedById   String?
  approvedAt     DateTime?

  scores VendorScore[]

  @@map("vendor_evaluations")
}

model VendorScore {
  id            String              @id @default(cuid())
  evaluationId  String
  evaluation    VendorEvaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  criterionId   String
  criterion     EvaluationCriterion @relation(fields: [criterionId], references: [id])
  score         Float
  maxScore      Float
  weight        Float               @default(1)
  weightedScore Float               @default(0)
  comment       String?

  @@unique([evaluationId, criterionId])
  @@map("vendor_scores")
}

model VendorPerformance {
  id          String   @id @default(cuid())
  vendorId    String
  vendor      Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime

  ordersCount          Int   @default(0)
  totalSpend           Float @default(0)
  onTimeDeliveries     Int   @default(0)
  lateDeliveries       Int   @default(0)
  partialDeliveries    Int   @default(0)
  rejectedLines        Int   @default(0)
  acceptedLines        Int   @default(0)
  qualityIssues        Int   @default(0)
  invoiceIssues        Int   @default(0)
  warrantyClaims       Int   @default(0)
  replacementsHonoured Int   @default(0)
  complaints           Int   @default(0)
  avgPriceVariance     Float @default(0)
  onTimePercent        Float @default(0)
  qualityPercent       Float @default(0)
  rejectionPercent     Float @default(0)
  score                Float @default(0)

  computedAt DateTime @default(now())

  @@unique([vendorId, periodStart, periodEnd])
  @@map("vendor_performance")
}

model VendorIssue {
  id       String @id @default(cuid())
  number   String @unique
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// LATE_DELIVERY | QUALITY | QUANTITY_SHORT | PRICE_MISMATCH | FORGED_DOCUMENT | ALTERED_DOCUMENT | SERVICE_FAILURE | AUDIT_FINDING | WARRANTY_DENIED | POLICY_VIOLATION | OTHER
  issueType String

  /// LOW | MEDIUM | HIGH | CRITICAL
  severity    String @default("MEDIUM")
  title       String
  description String

  relatedPoId      String?
  relatedGrnId     String?
  relatedInvoiceId String?
  raisedById       String
  raisedBy         User     @relation("VendorIssueRaisedBy", fields: [raisedById], references: [id])
  raisedAt         DateTime @default(now())

  /// OPEN | UNDER_REVIEW | VENDOR_RESPONDED | RESOLVED | ESCALATED | CLOSED
  status          String    @default("OPEN")
  vendorResponse  String?
  resolution      String?
  resolvedAt      DateTime?
  blacklistCaseId String?

  @@map("vendor_issues")
}

model VendorBlacklistCase {
  id       String @id @default(cuid())
  number   String @unique
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  reason   String

  /// FORGED_DOCUMENTS | ALTERED_DOCUMENTS | QUALITY_COMPROMISE | INVOICE_MISMATCH | QUANTITY_MISMATCH | PARTIAL_DELIVERIES | LATE_DELIVERIES | SERVICE_FAILURE | AUDIT_FINDING | POLICY_VIOLATION | OTHER
  reasonCode String
  evidence   String?

  /// RAISED | EVIDENCE_COLLECTION | INVESTIGATION | VENDOR_RESPONSE_AWAITED | PROCUREMENT_REVIEW | AUDIT_REVIEW | DECISION_PENDING | BLACKLISTED | WARNING_ISSUED | RETAINED | CLOSED
  stage              String    @default("RAISED")
  investigationNotes String?
  vendorResponse     String?
  vendorRespondedAt  DateTime?
  procurementReview  String?
  auditReview        String?
  auditRequired      Boolean   @default(true)

  /// BLACKLIST | RETAIN | WARNING | SUSPEND
  decision      String?
  decisionBy    String?
  decisionAt    DateTime?
  decisionNotes String?
  raisedById    String
  raisedAt      DateTime  @default(now())
  closedAt      DateTime?

  @@map("vendor_blacklist_cases")
}

// ─────────────────────────────────────────────────────────────
// ASSETS / DISPOSAL
// ─────────────────────────────────────────────────────────────

model Asset {
  id           String      @id @default(cuid())
  assetId      String      @unique
  tag          String      @unique
  name         String
  description  String?
  entityId     String
  entity       Entity      @relation(fields: [entityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  itemId       String?
  item         Item?       @relation(fields: [itemId], references: [id])

  office       String?
  location     String?
  storeId      String?
  serialNumber String?
  brand        String?
  model        String?
  purchaseDate DateTime?
  vendorId     String?
  vendor       Vendor?   @relation(fields: [vendorId], references: [id])
  poId         String?
  grnId        String?
  grn          Grn?      @relation(fields: [grnId], references: [id])

  cost             Float     @default(0)
  currentValue     Float?
  depreciationRate Float?
  warrantyUntil    DateTime?
  custodianId      String?
  custodian        User?     @relation("AssetCustodian", fields: [custodianId], references: [id])

  /// The identifiers finance and operations each key on. They are kept distinct
  /// because the tag on the chair, the row in the fixed-asset register and the
  /// code in the accounting system are three different things that must agree.
  trackingId   String? @unique
  sageCode     String?
  farReference String?
  capitalised  Boolean @default(false)

  /// ACTIVE | IN_STORAGE | ISSUED | TRANSFERRED | UNDER_REPAIR | IDLE | OBSOLETE | DISPOSED | SCRAPPED | LOST
  status         String   @default("IN_STORAGE")
  conditionNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  transactions  AssetTransaction[]
  disposalItems DisposalItem[]

  insurance AssetInsurance[]

  serialUnits SerialUnit[]
  employeeReturnLines EmployeeReturnItem[]
  lossReportLines LossReportItem[]
  @@index([status])
  @@map("assets")
}

model AssetTransaction {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// TAGGED | ISSUED | RETURNED | TRANSFERRED | REPAIR_IN | REPAIR_OUT | REVALUED | FLAGGED_IDLE | FLAGGED_OBSOLETE | DISPOSED | SCRAPPED | LOST
  type            String
  fromStatus      String?
  toStatus        String?
  fromCustodianId String?
  toCustodianId   String?
  fromLocation    String?
  toLocation      String?
  reference       String?
  notes           String?
  performedById   String
  performedAt     DateTime @default(now())

  @@map("asset_transactions")
}

model DisposalCase {
  id       String @id @default(cuid())
  number   String @unique
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])
  title    String

  /// FURNITURE | IT_HARDWARE | MOBILE | MARKETING_MATERIAL | CONSTRUCTION_SCRAP | COMPLETE_WASTE | EQUIPMENT | OTHER
  disposalCategory String

  /// REUSE | TRANSFER | REPAIR | SCRAP | DISPOSE | SALE
  recommendedAction String?
  finalAction       String?
  assessmentNotes   String?
  estimatedValue    Float?
  realisedValue     Float?

  /// FLAGGED | ASSESSMENT | AUDIT_REVIEW | PENDING_APPROVAL | APPROVED | BIDDING | BID_EVALUATION | MANAGEMENT_APPROVAL | PAYMENT_PENDING | PAYMENT_RECEIVED | COMPLETED | REJECTED | CANCELLED
  stage             String    @default("FLAGGED")
  biddingRequired   Boolean   @default(true)
  bidDeadline       DateTime?
  winningBidId      String?
  paymentReceivedAt DateTime?
  paymentReference  String?

  raisedById             String
  raisedBy               User      @relation("DisposalRaisedBy", fields: [raisedById], references: [id])
  raisedAt               DateTime  @default(now())
  auditReviewById        String?
  auditReviewAt          DateTime?
  auditNotes             String?
  approvedById           String?
  approvedAt             DateTime?
  managementApprovedById String?
  managementApprovedAt   DateTime?
  completedAt            DateTime?
  updatedAt              DateTime  @updatedAt

  items        DisposalItem[]
  bids         DisposalBid[]
  transactions InventoryTransaction[]

  /// ── Scrap Material Policy · the eight stages and their evidence ──────────
  ///
  /// ZAM/PUR/SOP-01's disposal procedure is a table of eight rows, each with a
  /// named process owner. The stage machine already existed; what did not was
  /// the evidence each stage is supposed to produce, so a case could walk the
  /// whole ladder with nothing behind any rung.

  /// Stage 1 — "Physical Inspection of Scrap Material · Physical Inspection
  /// Report will be maintained." Owner: Admin / related department / Logistics /
  /// Internal Audit.
  physicalInspectionById    String?
  physicalInspectionBy      User?     @relation("DisposalInspectedBy", fields: [physicalInspectionById], references: [id])
  physicalInspectionAt      DateTime?
  physicalInspectionReport  String?

  /// Stage 3 — "Finance will determine and give feedback for the depreciated
  /// value & residual value." Held as two figures rather than one, because they
  /// are two different numbers and the write-off is the difference.
  netBookValue        Float?
  residualValue       Float?
  financeAssessedById String?
  financeAssessedBy   User?     @relation("DisposalFinanceBy", fields: [financeAssessedById], references: [id])
  financeAssessedAt   DateTime?
  financeNotes        String?

  /// Stage 4 — the SOP offers an alternative to committee approval: "In case of
  /// insignificant value/quantum after consulting with relevant/concerned
  /// business head". Taking that route is a choice somebody makes and defends,
  /// so it names the head consulted rather than merely skipping the committee.
  insignificantValue        Boolean @default(false)
  businessHeadConsultedId   String?
  businessHeadConsulted     User?     @relation("DisposalBusinessHead", fields: [businessHeadConsultedId], references: [id])
  businessHeadConsultedAt   DateTime?
  insignificanceJustification String?

  /// Stage 8 — "Finance will update FAR at their end & inventory will update its
  /// records accordingly." The FAR is Finance's system, so this records the
  /// hand-off and its reference rather than pretending to own the register.
  farUpdatedById String?
  farUpdatedAt   DateTime?
  farReference   String?
  writeOffAmount Float?

  witnesses DisposalWitness[]
  @@index([stage])
  @@map("disposal_cases")
}

model DisposalItem {
  id      String       @id @default(cuid())
  caseId  String
  case    DisposalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  lineNo  Int
  assetId String?
  asset   Asset?       @relation(fields: [assetId], references: [id])
  itemId  String?
  item    Item?        @relation(fields: [itemId], references: [id])
  storeId String?

  description String
  quantity    Float
  unit        String

  /// IDLE | OBSOLETE | DAMAGED | UNREPAIRABLE | EXPIRED | SCRAP
  condition      String  @default("OBSOLETE")
  bookValue      Float?
  estimatedValue Float?
  realisedValue  Float?
  disposition    String?
  notes          String?

  @@unique([caseId, lineNo])
  @@map("disposal_items")
}

model DisposalBid {
  id         String       @id @default(cuid())
  caseId     String
  case       DisposalCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  bidderName String
  vendorId   String?
  vendor     Vendor?      @relation(fields: [vendorId], references: [id])

  contactPhone String?
  amount       Float
  currency     String   @default("PKR")
  bidDate      DateTime @default(now())

  /// SUBMITTED | SHORTLISTED | WON | LOST | WITHDRAWN | DISQUALIFIED
  status String  @default("SUBMITTED")
  notes  String?

  @@map("disposal_bids")
}

// ─────────────────────────────────────────────────────────────
// DOCUMENTS / AUDIT / NOTIFICATIONS / TASKS / EXCEPTIONS
// ─────────────────────────────────────────────────────────────

model DocumentType {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  category String

  /// JSON array of entity types this doc can attach to
  appliesTo         String  @default("[]")
  required          Boolean @default(false)
  maxSizeMb         Int     @default(20)
  allowedExtensions String  @default("pdf,png,jpg,jpeg,xlsx,xls,docx,doc,dwg,csv")
  retentionMonths   Int?

  /// Minimum permission code required to view
  viewPermission String?
  active         Boolean @default(true)

  documents Document[]

  paymentPackRequirements PaymentPackRequirement[]
  @@map("document_types")
}

model Document {
  id               String  @id @default(cuid())
  name             String
  originalFilename String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  checksum         String?
  version          Int     @default(1)

  parentDocumentId String?
  parentDocument   Document?  @relation("DocVersions", fields: [parentDocumentId], references: [id])
  versions         Document[] @relation("DocVersions")

  documentTypeId String?
  documentType   DocumentType? @relation(fields: [documentTypeId], references: [id])

  /// PR | RFQ | QUOTE | COMPARATIVE | PO | GATE_PASS | DELIVERY | INSPECTION | GRN | INVOICE | VENDOR | PETTY_CASH | DISPOSAL | ASSET | CPC | STORE_TRANSFER | STORE_ISSUE
  linkedType String
  linkedId   String

  /// Denormalized case key so the whole procurement case timeline can be fetched in one query
  caseKey     String?
  category    String  @default("General")
  description String?
  tags        String?

  /// PUBLIC | INTERNAL | CONFIDENTIAL | RESTRICTED
  confidentiality String   @default("INTERNAL")
  entityId        String?
  uploadedById    String
  uploadedBy      User     @relation(fields: [uploadedById], references: [id])
  uploadedAt      DateTime @default(now())
  isCurrent       Boolean  @default(true)
  archived        Boolean  @default(false)

  accessLogs DocumentAccessLog[]

  @@index([linkedType, linkedId])
  @@index([caseKey])
  @@map("documents")
}

model DocumentAccessLog {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String

  /// VIEW | DOWNLOAD | DENIED
  action     String
  ip         String?
  accessedAt DateTime @default(now())

  @@index([documentId])
  @@map("document_access_logs")
}

model AuditLog {
  id         String  @id @default(cuid())
  entityType String
  entityId   String
  entityRef  String?
  action     String

  /// JSON of {field: {from, to}}
  changes  String?
  oldValue String?
  newValue String?
  reason   String?

  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  actorName  String?
  actorRoles String?
  ip         String?
  userAgent  String?
  caseKey    String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([caseKey])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// APPROVAL_REQUIRED | PR_RETURNED | PR_REJECTED | RFQ_RESPONSE_PENDING | QUOTE_RECEIVED | CPC_PENDING | PO_APPROVAL | DELIVERY_OVERDUE | INSPECTION_REQUIRED | GRN_PENDING | INVOICE_MISMATCH | FINANCE_HANDOFF | VENDOR_EVALUATION_DUE | VENDOR_ISSUE | DISPOSAL_APPROVAL | EXCEPTION_RAISED | GENERAL
  type  String
  title String
  body  String?

  /// LOW | NORMAL | HIGH | CRITICAL
  priority  String    @default("NORMAL")
  linkType  String?
  linkId    String?
  linkUrl   String?
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, read])
  @@map("notifications")
}

/// Queued outbound email. Notifications are written first and mailed from here,
/// so a transport being down delays delivery but never loses the message, and
/// every attempt is inspectable after the fact.
model EmailMessage {
  id        String  @id @default(cuid())
  toAddress String
  toName    String?
  subject   String
  bodyText  String
  bodyHtml  String?

  /// APPROVAL | REMINDER | EXCEPTION | DIGEST | GENERAL
  category String @default("GENERAL")

  /// QUEUED | SENDING | SENT | FAILED | SUPPRESSED
  status    String  @default("QUEUED")
  attempts  Int     @default(0)
  lastError String?

  /// Transport that accepted it, e.g. logger or smtp
  transport  String?
  providerId String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  notificationId String?
  linkUrl        String?
  entityId       String?

  queuedAt DateTime  @default(now())
  sentAt   DateTime?
  failedAt DateTime?

  @@index([status, queuedAt])
  @@map("email_messages")
}

model Task {
  id          String  @id @default(cuid())
  title       String
  description String?

  /// APPROVAL | ACTION | REVIEW | DATA_ENTRY | INSPECTION | RECEIVING | VERIFICATION
  taskType         String  @default("ACTION")
  assigneeId       String?
  assignee         User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignedRoleCode String?
  entityId         String?
  documentType     String
  documentId       String
  documentRef      String

  /// OPEN | IN_PROGRESS | DONE | CANCELLED
  status        String    @default("OPEN")
  priority      String    @default("NORMAL")
  dueAt         DateTime?
  slaHours      Int?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  completedById String?
  linkUrl       String?

  @@index([assigneeId, status])
  @@index([assignedRoleCode, status])
  @@map("tasks")
}

model Exception {
  id     String @id @default(cuid())
  number String @unique

  /// MISSING_SPECIFICATION | APPROVAL_DELAY | INSUFFICIENT_QUOTATIONS | PRICE_VARIANCE | NON_LOWEST_SELECTED | LATE_DELIVERY | QUANTITY_MISMATCH | DAMAGED_MATERIAL | FAILED_INSPECTION | MISSING_GRN | INVOICE_MISMATCH | VENDOR_COMPLIANCE | STORE_ENTRY_MISSING | BUDGET_OVERRUN | OTHER
  type String

  /// LOW | MEDIUM | HIGH | CRITICAL
  severity    String  @default("MEDIUM")
  title       String
  description String?
  reason      String?

  documentType String
  documentId   String
  documentRef  String
  caseKey      String?
  entityId     String?

  prId      String?
  pr        PurchaseRequisition? @relation(fields: [prId], references: [id])
  poId      String?
  po        PurchaseOrder?       @relation(fields: [poId], references: [id])
  invoiceId String?
  invoice   Invoice?             @relation(fields: [invoiceId], references: [id])

  ownerId    String?
  owner      User?   @relation("ExceptionOwner", fields: [ownerId], references: [id])
  raisedById String?
  raisedBy   User?   @relation("ExceptionRaisedBy", fields: [raisedById], references: [id])

  /// OPEN | IN_PROGRESS | RESOLVED | ACCEPTED | WAIVED | CLOSED
  status       String    @default("OPEN")
  blocking     Boolean   @default(false)
  dueAt        DateTime?
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  /// ── Acknowledgement and escalation ──────────────────────────────────────
  ///
  /// An exception with an owner and a due date is a record. It becomes a control
  /// when somebody has to say they have seen it, and when nobody saying so has a
  /// consequence.
  ///
  /// Acknowledgement is deliberately separate from resolution: "I know about
  /// this" and "this is dealt with" are different claims, and collapsing them
  /// means an owner cannot tell you they are on it without also telling you it
  /// is finished.
  acknowledgedById String?
  acknowledgedBy   User?     @relation("ExceptionAcknowledgedBy", fields: [acknowledgedById], references: [id])
  acknowledgedAt   DateTime?

  /// How far up the reporting line this has been pushed. Zero is where it
  /// started. Each step names who it went to, so an escalation is a fact about
  /// two people rather than a flag.
  escalationLevel Int       @default(0)
  escalatedToId   String?
  escalatedTo     User?     @relation("ExceptionEscalatedTo", fields: [escalatedToId], references: [id])
  escalatedAt     DateTime?
  escalationNote  String?
  @@index([status, severity])
  @@index([documentType, documentId])
  @@map("exceptions")
}

model SavingsRecord {
  id            String         @id @default(cuid())
  comparativeId String?
  comparative   Comparative?   @relation(fields: [comparativeId], references: [id])
  poId          String?
  po            PurchaseOrder? @relation(fields: [poId], references: [id])
  entityId      String?
  categoryId    String?
  vendorId      String?

  itemDescription String
  quantity        Float  @default(0)
  marketPrice     Float?
  previousPrice   Float?
  initialQuote    Float?
  negotiatedPrice Float?
  finalPrice      Float
  savingsPerUnit  Float  @default(0)
  totalSavings    Float  @default(0)
  savingsPercent  Float  @default(0)

  /// NEGOTIATION | TIMING | VENDOR_SWITCH | BULK | SPEC_OPTIMISATION | MARKET_RATE
  savingsType String   @default("NEGOTIATION")
  notes       String?
  recordedAt  DateTime @default(now())

  @@index([entityId, recordedAt])
  @@map("savings_records")
}

model NumberSequence {
  id      String @id @default(cuid())
  key     String @unique
  prefix  String
  year    Int
  counter Int    @default(0)
  padding Int    @default(5)

  @@map("number_sequences")
}

model SavedView {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name     String
  resource String

  /// JSON of filters/sort/columns
  config    String   @default("{}")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, resource, name])
  @@map("saved_views")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Demand layer
///
/// A department states what it needs; the system decides whether stock can meet
/// it before anybody is allowed to buy. Requirement is that front door, and the
/// availability it recorded at the moment of the decision is kept on the line
/// rather than recomputed later — otherwise nobody can explain, six months on,
/// why a purchase was allowed when the stock report says there was plenty.
/// ─────────────────────────────────────────────────────────────────────────────
model Requirement {
  id           String     @id @default(cuid())
  number       String     @unique
  entityId     String
  entity       Entity     @relation(fields: [entityId], references: [id])
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  requesterId  String
  requester    User       @relation("RequirementRequester", fields: [requesterId], references: [id])

  title         String
  purpose       String?
  justification String?
  /// LOW | NORMAL | HIGH | URGENT
  priority      String   @default("NORMAL")
  requiredDate  DateTime

  /// Where the goods are needed, and the store that serves it.
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id])

  costCenter      String?
  costCenterId    String?
  /// CAPEX | OPEX
  expenditureType String  @default("OPEX")
  estimatedValue  Float   @default(0)
  currency        String  @default("PKR")

  /// DRAFT | SUBMITTED | CHECKING_STOCK | FULFILLED_FROM_STOCK | SPLIT
  /// | SENT_TO_PROCUREMENT | CLOSED | CANCELLED
  status String @default("DRAFT")

  submittedAt  DateTime?
  checkedAt    DateTime?
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?     @relation("RequirementDecidedBy", fields: [decidedById], references: [id])
  /// Why the requirement went the way it did — required when stock existed and
  /// procurement was chosen anyway.
  decisionNote String?
  closedAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items        RequirementItem[]
  storeIssues  StoreIssue[]
  requisitions PurchaseRequisition[]

  @@index([entityId, status])
  @@index([status])
  @@map("requirements")
}

model RequirementItem {
  id            String      @id @default(cuid())
  requirementId String
  requirement   Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  lineNo        Int

  itemId            String?
  item              Item?     @relation(fields: [itemId], references: [id])
  categoryId        String?
  category          Category? @relation(fields: [categoryId], references: [id])
  description       String
  specification     String?
  quantity          Float
  unit              String
  estimatedUnitCost Float?

  /// The availability snapshot taken when the decision was made.
  physicalQty   Float   @default(0)
  reservedQty   Float   @default(0)
  availableQty  Float   @default(0)
  /// How the quantity was split by that decision.
  fromStockQty  Float   @default(0)
  procureQty    Float   @default(0)
  /// The store the stock was found in — not always the requesting store.
  sourceStoreId String?
  sourceStore   Store?  @relation(fields: [sourceStoreId], references: [id])

  reservations InventoryReservation[]

  @@unique([requirementId, lineNo])
  @@index([itemId])
  @@map("requirement_items")
}

/// Reserved stock is not available stock. Without a record of who reserved what,
/// two requirements are promised the same carton and the second one discovers it
/// at the counter.
model InventoryReservation {
  id      String @id @default(cuid())
  itemId  String
  item    Item   @relation(fields: [itemId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  quantity Float
  unit     String

  requirementItemId String?
  requirementItem   RequirementItem? @relation(fields: [requirementItemId], references: [id])
  storeIssueId      String?
  storeIssue        StoreIssue?      @relation(fields: [storeIssueId], references: [id])

  /// ACTIVE | RELEASED | CONSUMED
  status      String    @default("ACTIVE")
  reason      String?
  createdById String
  createdBy   User      @relation("ReservationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  releasedAt  DateTime?
  consumedAt  DateTime?
  expiresAt   DateTime?

  @@index([itemId, storeId, status])
  @@map("inventory_reservations")
}

/// One requisition line can be split across several orders, and one order can
/// serve several requisitions. A `purchase_orders.pr_id` column cannot express
/// either, so the quantity actually placed lives here.
model PrPoAllocation {
  id       String                  @id @default(cuid())
  prId     String
  pr       PurchaseRequisition     @relation(fields: [prId], references: [id], onDelete: Cascade)
  prItemId String
  prItem   PurchaseRequisitionItem @relation(fields: [prItemId], references: [id], onDelete: Cascade)
  poId     String
  po       PurchaseOrder           @relation(fields: [poId], references: [id], onDelete: Cascade)
  poItemId String?
  poItem   PurchaseOrderItem?      @relation(fields: [poItemId], references: [id])

  quantity Float
  unit     String

  createdById String?
  createdBy   User?    @relation("AllocationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@unique([prItemId, poItemId])
  @@index([prId])
  @@index([poId])
  @@map("pr_po_allocations")
}

/// Cost centres were a free-text field on the requisition, which cannot be
/// reported on or reconciled against finance.
model CostCenter {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  entityId     String?
  entity       Entity?     @relation(fields: [entityId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())

  budgets Budget[]

  @@map("cost_centers")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Finance masters
/// ─────────────────────────────────────────────────────────────────────────────

/// Tax rates as data. A rate written into code is a rate nobody can change when
/// the budget speech does.
model Tax {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  /// SALES | INCOME | WITHHOLDING | FED | PROVINCIAL | CUSTOMS | OTHER
  type      String
  rate      Float
  /// Withholding is deducted from what the vendor is paid rather than added to it.
  withheld  Boolean  @default(false)
  entityId  String?
  entity    Entity?  @relation(fields: [entityId], references: [id])
  /// Ledger account this tax posts to, where finance has told us one.
  glAccount String?
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())

  invoiceLines InvoiceTaxLine[]

  @@map("taxes")
}

/// The tax actually applied to an invoice, kept per line rather than as a single
/// figure — an invoice can carry sales tax on one line and none on another, and a
/// total cannot be reconciled back to a rate.
model InvoiceTaxLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  taxId     String?
  tax       Tax?    @relation(fields: [taxId], references: [id])

  label        String
  rate         Float
  base         Float
  amount       Float
  withheld     Boolean   @default(false)
  /// PENDING | VERIFIED | DISPUTED
  status       String    @default("PENDING")
  verifiedById String?
  verifiedAt   DateTime?
  notes        String?

  @@index([invoiceId])
  @@map("invoice_tax_lines")
}

/// Budget held by entity, year and whichever dimension finance controls on.
///
/// Committed and utilised are derived from live documents rather than stored, so
/// they cannot drift: an approved order commits, a posted receipt utilises.
model Budget {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])
  /// Financial year label as finance writes it, e.g. "2026" or "2025-26".
  year     String

  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  costCenterId    String?
  costCenter      CostCenter? @relation(fields: [costCenterId], references: [id])
  categoryId      String?
  category        Category?   @relation(fields: [categoryId], references: [id])
  /// CAPEX | OPEX | BOTH
  expenditureType String      @default("BOTH")

  allocated Float    @default(0)
  currency  String   @default("PKR")
  /// Blocks approval past the allocation rather than only reporting it.
  hardLimit Boolean  @default(false)
  active    Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, year, departmentId, costCenterId, categoryId, expenditureType])
  @@index([entityId, year])
  @@map("budgets")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Payment voucher and signatories
/// ─────────────────────────────────────────────────────────────────────────────

/// The voucher is what finance signs before money moves.
///
/// It is generated from an invoice only when the documents behind it stand up —
/// the order, the receipt, the match and the tax — so the signatories are asked
/// to approve a payment that has already been proven, not to do the proving.
model Voucher {
  id        String  @id @default(cuid())
  number    String  @unique
  entityId  String
  entity    Entity  @relation(fields: [entityId], references: [id])
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  /// PAYMENT | ADVANCE | ADJUSTMENT | REFUND
  type String @default("PAYMENT")

  currency       String @default("PKR")
  grossAmount    Float  @default(0)
  taxAmount      Float  @default(0)
  withholdingTax Float  @default(0)
  deductions     Float  @default(0)
  netAmount      Float  @default(0)

  /// DRAFT | PENDING_SIGNATORIES | APPROVED | REJECTED | PAID | CANCELLED
  status String @default("DRAFT")

  narration    String?
  glAccount    String?
  costCenterId String?

  preparedById String
  preparedBy   User     @relation("VoucherPreparedBy", fields: [preparedById], references: [id])
  preparedAt   DateTime @default(now())

  approvedAt   DateTime?
  rejectedAt   DateTime?
  rejectReason String?
  paidAt       DateTime?
  cancelledAt  DateTime?

  items      VoucherItem[]
  signatures SignatoryApproval[]
  payments   PaymentHandoff[]

  @@index([status])
  @@index([invoiceId])
  @@map("vouchers")
}

model VoucherItem {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  lineNo    Int

  description String
  amount      Float
  /// DEBIT | CREDIT
  side        String  @default("DEBIT")
  glAccount   String?
  costCenter  String?
  notes       String?

  @@unique([voucherId, lineNo])
  @@map("voucher_items")
}

/// One signature on one voucher, in order.
///
/// Held as rows rather than a status field because who signed, in what order and
/// when is the whole point of a signatory hierarchy.
model SignatoryApproval {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  sequence        Int
  /// Role expected to sign at this step.
  roleCode        String
  /// Amount above which this step applies at all.
  thresholdAmount Float  @default(0)

  /// PENDING | APPROVED | REJECTED | SKIPPED
  status String @default("PENDING")

  signedById String?
  signedBy   User?     @relation("SignatoryUser", fields: [signedById], references: [id])
  signedAt   DateTime?
  comment    String?

  @@unique([voucherId, sequence])
  @@map("signatory_approvals")
}

/// A three-way match, kept as a record rather than only a verdict.
///
/// The invoice carries the current match state; this keeps each attempt, so a
/// dispute over what was known when has an answer.
model ThreeWayMatch {
  id        String         @id @default(cuid())
  invoiceId String
  invoice   Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  poId      String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  grnId     String?
  grn       Grn?           @relation(fields: [grnId], references: [id])

  /// PASSED | FAILED | OVERRIDDEN
  result String

  quantityMatched Boolean @default(false)
  priceMatched    Boolean @default(false)
  taxMatched      Boolean @default(false)
  totalMatched    Boolean @default(false)

  poTotal      Float @default(0)
  grnValue     Float @default(0)
  invoiceTotal Float @default(0)
  variance     Float @default(0)

  /// The failing lines, as JSON, so the report can be rebuilt exactly.
  detail String @default("[]")

  overriddenById String?
  overrideReason String?
  runById        String?
  runAt          DateTime @default(now())

  @@index([invoiceId])
  @@map("three_way_matches")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Receiving exceptions
/// ─────────────────────────────────────────────────────────────────────────────

/// A difference between what was ordered and what the receipt recorded.
///
/// The specification says the mismatch is "zeroed out". That must not mean the
/// difference disappears: it means the transaction is squared off and the
/// difference is recorded here, owned and dated, with the reason it was allowed.
model PoVariance {
  id     String        @id @default(cuid())
  number String        @unique
  poId   String
  po     PurchaseOrder @relation(fields: [poId], references: [id])
  grnId  String?
  grn    Grn?          @relation(fields: [grnId], references: [id])

  /// QUANTITY | PRICE | TAX | TOTAL | SPECIFICATION
  type String

  poQuantity  Float?
  grnQuantity Float?
  poValue     Float?
  grnValue    Float?
  variance    Float  @default(0)
  variancePct Float?

  /// SHORT_SUPPLY | OVER_SUPPLY | PRICE_CHANGE | ROUNDING | DAMAGE | OTHER
  reasonCode String
  reason     String?

  /// OPEN | ACCEPTED | RECOVERED | WRITTEN_OFF | DISPUTED
  status String @default("OPEN")

  resolvedById String?
  resolvedBy   User?     @relation("VarianceResolvedBy", fields: [resolvedById], references: [id])
  resolvedAt   DateTime?
  resolution   String?
  approvedById String?
  createdAt    DateTime  @default(now())

  @@index([poId])
  @@index([status])
  @@map("po_variances")
}

/// Goods refused at the gate or on inspection.
///
/// Recorded whether or not they ever touched inventory, because "rejected and
/// sent back" and "received, then found faulty and adjusted out" are different
/// events with different consequences for the vendor record.
model RejectionRecord {
  id     String @id @default(cuid())
  number String @unique

  deliveryId   String?
  delivery     Delivery?   @relation(fields: [deliveryId], references: [id])
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])
  grnId        String?
  grn          Grn?        @relation(fields: [grnId], references: [id])
  itemId       String?
  item         Item?       @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unit        String

  /// DAMAGED | WRONG_ITEM | WRONG_SPEC | EXPIRED | SHORT | EXCESS | FAILED_TEST | MISSING_DOCUMENT | OTHER
  reasonCode String
  reason     String?

  /// SPOT_REJECTION — never entered stock; ADJUSTED_OUT — was received first.
  disposition       String  @default("SPOT_REJECTION")
  /// Was inventory reduced to account for this?
  inventoryAdjusted Boolean @default(false)

  raisedById String
  raisedBy   User     @relation("RejectionRaisedBy", fields: [raisedById], references: [id])
  raisedAt   DateTime @default(now())

  returnId String?
  return   VendorReturn? @relation(fields: [returnId], references: [id])

  @@index([deliveryId])
  @@map("rejection_records")
}

/// Goods going back to the vendor, and whether a replacement is owed.
model VendorReturn {
  id       String         @id @default(cuid())
  number   String         @unique
  vendorId String
  vendor   Vendor         @relation(fields: [vendorId], references: [id])
  poId     String?
  po       PurchaseOrder? @relation(fields: [poId], references: [id])
  grnId    String?
  grn      Grn?           @relation(fields: [grnId], references: [id])

  /// DRAFT | AUTHORISED | DISPATCHED | ACKNOWLEDGED | REPLACED | CREDITED | CLOSED | CANCELLED
  status String @default("DRAFT")

  reason     String
  totalValue Float  @default(0)
  currency   String @default("PKR")

  replacementRequired Boolean   @default(false)
  /// NOT_REQUIRED | AWAITED | RECEIVED | CREDIT_NOTE | REFUSED
  replacementStatus   String    @default("NOT_REQUIRED")
  replacementDueDate  DateTime?
  replacementGrnId    String?
  creditNoteRef       String?
  creditNoteAmount    Float?

  gatePassRef    String?
  dispatchedAt   DateTime?
  acknowledgedAt DateTime?
  closedAt       DateTime?

  raisedById String
  raisedBy   User     @relation("ReturnRaisedBy", fields: [raisedById], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items      VendorReturnItem[]
  rejections RejectionRecord[]

  /// The inspection that failed, when the return comes from one.
  /// ZAM/PUR/SOP-01 Store Flow step 3: "If inspection fails, a Return-to-Vendor
  /// (RTV) document will be lodged by the relevant inspector within the ERP."
  /// Held here rather than inferred through the rejection records, so a second
  /// return cannot be raised against the same failed inspection by accident.
  inspectionId String?
  inspection   Inspection? @relation(fields: [inspectionId], references: [id])
  @@index([vendorId])
  @@index([status])
  @@map("vendor_returns")
}

model VendorReturnItem {
  id       String       @id @default(cuid())
  returnId String
  return   VendorReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  lineNo   Int
  itemId   String?
  item     Item?        @relation(fields: [itemId], references: [id])

  description String
  quantity    Float
  unit        String
  unitValue   Float   @default(0)
  lineValue   Float   @default(0)
  reasonCode  String?
  notes       String?

  @@unique([returnId, lineNo])
  @@map("vendor_return_items")
}

/// ─────────────────────────────────────────────────────────────────────────────
/// Masters the specification asks for by name
/// ─────────────────────────────────────────────────────────────────────────────

/// Units of measure, with the conversion needed to compare a box against an each.
model Uom {
  id        String  @id @default(cuid())
  code      String  @unique
  name      String
  /// COUNT | WEIGHT | VOLUME | LENGTH | AREA | TIME
  dimension String  @default("COUNT")
  /// How many of `baseCode` one of this unit is, where a base exists.
  baseCode  String?
  factor    Float?
  entityId  String?
  entity    Entity? @relation(fields: [entityId], references: [id])
  active    Boolean @default(true)

  @@map("uoms")
}

/// The formula an item code is built from.
///
/// The specification is explicit that codes are derived rather than typed, so the
/// pattern lives as data: segments naming what they draw on, and a counter per
/// resolved prefix.
model ItemCodeRule {
  id         String    @id @default(cuid())
  entityId   String?
  entity     Entity?   @relation(fields: [entityId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Segments joined by `separator`, each either a literal or a field reference:
  /// ENTITY | CATEGORY | SUBCATEGORY | LOCATION | SEQUENCE | LITERAL:<text>
  pattern       String
  separator     String  @default("-")
  /// Width the sequence is padded to, e.g. 4 gives 0001.
  sequenceWidth Int     @default(4)
  active        Boolean @default(true)
  notes         String?

  @@map("item_code_rules")
}

/// Points of contact are assigned to departments, not stores.
model DepartmentPoc {
  id           String     @id @default(cuid())
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("PocUser", fields: [userId], references: [id])

  /// PROCUREMENT | RFQ | QUOTATION | COMPARATIVE | EVALUATION | PO | GENERAL
  responsibility String   @default("GENERAL")
  primary        Boolean  @default(false)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([departmentId, userId, responsibility])
  @@map("department_pocs")
}

/// Insurance held against an asset.
model AssetInsurance {
  id      String @id @default(cuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  policyNumber String
  insurer      String
  /// FIRE | THEFT | COMPREHENSIVE | MARINE | ENGINEERING | OTHER
  coverType    String   @default("COMPREHENSIVE")
  sumInsured   Float    @default(0)
  premium      Float    @default(0)
  currency     String   @default("PKR")
  startDate    DateTime
  endDate      DateTime
  /// ACTIVE | LAPSED | CLAIMED | CANCELLED
  status       String   @default("ACTIVE")
  claimRef     String?
  claimAmount  Float?
  documentId   String?
  notes        String?
  createdAt    DateTime @default(now())

  @@index([assetId])
  @@index([endDate])
  @@map("asset_insurance")
}

/// Tax Master.
///
/// ZAM/PUR/SOP-01 §4.8 defers to "the Income Tax Ordinance currently applicable
/// in Pakistan" and the payment flow routes computation to KPMG, so the SOP
/// states no percentage. The meeting requirement is a dropdown of applicable
/// Government of Pakistan taxes — which means the rates are data, entered and
/// approved by the business, never a literal in code.
///
/// Effective-dated: a rate change creates a new row rather than editing the old
/// one, so a transaction settled last year keeps the rate that governed it.
model TaxRule {
  id   String @id @default(cuid())
  code String
  name String

  /// GOODS | SERVICES | BOTH — goods and services can be taxed differently.
  appliesTo String @default("BOTH")

  /// PERCENT | FIXED — `percent` carries the figure either way.
  method  String @default("PERCENT")
  percent Float

  /// Withholding rather than an addition to the invoice value.
  withholding Boolean @default(false)

  /// FILER | NON_FILER | ANY — some rates depend on the vendor's tax status.
  vendorTaxStatus String @default("ANY")

  /// Null applies to every entity.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?
  active        Boolean   @default(true)

  /// Where the rate comes from — the SRO, circular or ordinance clause.
  sourceReference String?

  createdById  String
  createdBy    User      @relation("TaxRuleCreatedBy", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?     @relation("TaxRuleApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  poItems PurchaseOrderItem[]
  manualEntries ComparativeManualEntry[]

  @@index([code, effectiveFrom])
  @@index([entityId, active])
}

/// Service acceptance — the services counterpart to a goods receipt.
///
/// A service has nothing to put on a shelf, so forcing it through inventory
/// produces a fiction. What a service needs instead is somebody accountable
/// saying the work was done: the concerned point of contact confirms it, states
/// what proportion is accepted, and that acceptance is what makes the invoice
/// payable.
model ServiceAcceptance {
  id     String @id @default(cuid())
  number String @unique

  poId String
  po   PurchaseOrder @relation(fields: [poId], references: [id])

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  /// DRAFT | SUBMITTED | ACCEPTED | PARTIALLY_ACCEPTED | REJECTED | CANCELLED
  status String @default("DRAFT")

  /// The period the work covers, for a recurring or milestone service.
  serviceFrom DateTime?
  serviceTo   DateTime?

  /// The point of contact whose confirmation the SOP requires — §3.2 puts
  /// verification with the requesting department, not with procurement.
  pocUserId String?
  pocUser   User?   @relation("ServiceAcceptancePoc", fields: [pocUserId], references: [id])

  confirmedById String?
  confirmedBy   User?     @relation("ServiceAcceptanceConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  /// Why, when anything less than the full value is accepted.
  remarks         String?
  rejectionReason String?

  acceptedValue Float @default(0)
  orderedValue  Float @default(0)

  createdById String
  createdBy   User     @relation("ServiceAcceptanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ServiceAcceptanceItem[]

  @@index([poId, status])
  @@index([entityId, status])
}

model ServiceAcceptanceItem {
  id                  String            @id @default(cuid())
  serviceAcceptanceId String
  serviceAcceptance   ServiceAcceptance @relation(fields: [serviceAcceptanceId], references: [id], onDelete: Cascade)

  poItemId String
  poItem   PurchaseOrderItem @relation(fields: [poItemId], references: [id])

  lineNo      Int
  description String
  unit        String

  orderedQty  Float
  acceptedQty Float @default(0)
  rejectedQty Float @default(0)
  unitPrice   Float
  acceptedValue Float @default(0)

  /// Evidence the work was performed — a report reference, a photograph, a log.
  evidenceRef String?
  remarks     String?

  @@unique([serviceAcceptanceId, lineNo])
  @@index([poItemId])
}

/// A cost-comparison option entered by hand.
///
/// Not every comparison source is a formal quotation. A published price list, a
/// verbal quote over the phone, a rate from a framework contract, the price the
/// same thing cost last month — all are legitimate comparison evidence, and
/// requiring each to exist as a `VendorQuote` first meant either faking a
/// quotation or leaving the comparison thinner than it really was.
///
/// This is a **separate model on purpose.** A manual entry must never be
/// mistaken for something a vendor submitted, so it does not occupy the same
/// rows as `ComparativeLine`: it carries its own source, its own evidence
/// reference and its own reason for being entered by hand, and it is labelled
/// MANUAL wherever it is shown. A comparison built partly on a price list is
/// still useful — but only if a reader can see that is what it is.
model ComparativeManualEntry {
  id            String      @id @default(cuid())
  comparativeId String
  comparative   Comparative @relation(fields: [comparativeId], references: [id], onDelete: Cascade)

  /// A registered vendor where the price came from one, otherwise free text.
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id])
  sourceName String

  /// PRICE_LIST | VERBAL | EMAIL | RATE_CONTRACT | PRIOR_PURCHASE | MARKET_SURVEY | OTHER
  sourceType String @default("OTHER")

  description String
  unit        String
  quantity    Float
  rate        Float
  grossValue  Float

  /// The tax treatment as understood at entry, and the rule if one applies.
  taxRuleId String?
  taxRule   TaxRule? @relation(fields: [taxRuleId], references: [id])
  taxRate   Float?
  taxAmount Float    @default(0)
  taxNote   String?
  netValue  Float    @default(0)

  deliveryTerms String?
  paymentTerms  String?
  validUntil    DateTime?

  /// Where the price can be checked — a price list date, an email, a call log.
  evidenceRef String?

  /// Why this was entered by hand rather than obtained as a quotation. Required:
  /// it is the difference between thin evidence and undocumented evidence.
  reason String

  enteredById String
  enteredBy   User     @relation("ManualEntryEnteredBy", fields: [enteredById], references: [id])
  enteredAt   DateTime @default(now())

  @@index([comparativeId])
}

/// A signature, once, reusable.
///
/// The paper forms all end the same way: a name, a designation, a signature, a
/// stamp, a date and a time. Annexure 1 says of the last three that "Stamps,
/// Date, Time are compulsory to ensure compliance". The requisition, the cost
/// analysis, the inspection note, the order, the committee minute, the voucher
/// and the disposal file each want that block.
///
/// Adding six sets of signature columns to six tables is how a schema stops
/// being reviewable. So the block lives here once, addressed by document type
/// and id, and every form reads it the same way.
///
/// It records the *role at signing* rather than only the user, because a
/// signature means something because of the office the signer held at the time
/// — and offices change while records must not.
model Attestation {
  id String @id @default(cuid())

  /// PR | COMPARATIVE | INSPECTION | GRN | PO | CPC_CASE | VOUCHER | DISPOSAL | SERVICE_ACCEPTANCE
  documentType String
  documentId   String
  /// The document's own number, so an attestation is legible on its own.
  documentRef  String?
  /// Which version was signed. An approval points at what was actually approved.
  documentVersion Int @default(1)

  /// PREPARED | VERIFIED | REVIEWED | APPROVED | REJECTED | WITNESSED | ACKNOWLEDGED
  attestationType String
  /// APPROVED | REJECTED | NOTED — what the signer decided, where that differs
  /// from the kind of attestation they were giving.
  decision String?

  signedById String
  signedBy   User   @relation("AttestationSignedBy", fields: [signedById], references: [id])
  /// The office held at the moment of signing, captured rather than joined.
  roleAtSigning String?
  designation   String?

  /// Set when somebody signed for somebody else, under a recorded delegation.
  onBehalfOfId String?
  onBehalfOf   User?   @relation("AttestationOnBehalfOf", fields: [onBehalfOfId], references: [id])
  delegationRef String?

  /// The compulsory block. `stampRef` is what the physical stamp bore, for a
  /// form that was signed on paper and scanned back in.
  signedAt DateTime @default(now())
  stampRef String?

  comment String?
  /// Hash of the document as signed, where one is available — so a later change
  /// is detectable rather than merely improbable.
  documentHash String?

  ip        String?
  userAgent String?

  @@index([documentType, documentId])
  @@index([signedById])
}

/// One physical serialised unit.
///
/// Ten laptops received is ten machines, each with its own serial, its own
/// custodian and its own history. Holding that as a comma-joined string on a
/// receipt line meant the tenth laptop had no identity: it could not be issued
/// individually, its custodian could not be recorded, and nothing stopped the
/// same serial being received twice.
///
/// So a serialised item gets one row per unit, and the row is the unit's life —
/// received, stored, issued, returned, repaired, capitalised, disposed of.
model SerialUnit {
  id     String @id @default(cuid())
  serial String

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Where it came from.
  grnId     String?
  grn       Grn?     @relation(fields: [grnId], references: [id])
  grnItemId String?
  poId      String?
  po        PurchaseOrder? @relation(fields: [poId], references: [id])
  vendorId  String?
  vendor    Vendor?  @relation(fields: [vendorId], references: [id])
  receivedAt DateTime @default(now())
  unitCost   Float    @default(0)

  /// Where it is now.
  storeId         String?
  store           Store?         @relation(fields: [storeId], references: [id])
  storeLocationId String?
  storeLocation   StoreLocation? @relation(fields: [storeLocationId], references: [id])

  /// IN_STOCK | ISSUED | WITH_EMPLOYEE | IN_REPAIR | RETURNED_TO_VENDOR | CAPITALISED | DISPOSED | LOST
  status String @default("IN_STOCK")

  /// Who holds it, when it is out of the store.
  custodianId String?
  custodian   User?   @relation("SerialCustodian", fields: [custodianId], references: [id])

  /// The asset record, once it is capitalised.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  warrantyMonths Int?
  warrantyEnd    DateTime?
  expiryDate     DateTime?
  batchNumber    String?

  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements SerialMovement[]

  /// A serial identifies a unit of a given item, so it cannot repeat for that
  /// item. It deliberately *can* repeat across different items: two
  /// manufacturers reusing the same string is their business, not an error here.
  @@unique([itemId, serial])
  @@index([status, storeId])
  @@index([custodianId])
  @@index([serial])
}

/// A serialised unit's history, one row per thing that happened to it.
model SerialMovement {
  id           String     @id @default(cuid())
  serialUnitId String
  serialUnit   SerialUnit @relation(fields: [serialUnitId], references: [id], onDelete: Cascade)

  /// RECEIVED | STORED | ISSUED | RETURNED | SENT_FOR_REPAIR | REPAIRED | CAPITALISED | DISPOSED | LOST | TRANSFERRED
  event String

  fromStatus String?
  toStatus   String

  fromStoreId String?
  toStoreId   String?
  fromCustodianId String?
  toCustodianId   String?

  /// The document that caused it.
  reference     String?
  documentType  String?
  documentId    String?

  performedById String
  performedBy   User     @relation("SerialMovementBy", fields: [performedById], references: [id])
  performedAt   DateTime @default(now())
  remarks       String?

  @@index([serialUnitId, performedAt])
}

/// What documents a transaction needs before money leaves.
///
/// `DocumentType.required` is a single global boolean, which cannot express what
/// Annexure A actually says: the requisition, order, receipt and invoice are
/// always needed, while the undertaking, the goods declaration and the tax
/// exemption certificate are needed *when they apply*. A global flag forces a
/// choice between demanding a GD on every payment or never demanding one, and
/// the system chose never — all thirty types are optional today.
///
/// So the requirement is a row: this entity, this kind of transaction, this
/// document, always or conditionally, with the condition stated in words
/// somebody can check.
model PaymentPackRequirement {
  id String @id @default(cuid())

  /// Null applies to every entity.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// GOODS | SERVICES | PETTY_CASH | ADVANCE | DISPOSAL | ALL
  transactionType String @default("ALL")

  documentTypeId String
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])

  /// ALWAYS — the payment cannot proceed without it.
  /// CONDITIONAL — required only when `condition` holds; whoever assembles the
  ///   pack says whether it applies, and that answer is recorded.
  /// OPTIONAL — offered, never demanded.
  requirement String @default("ALWAYS")

  /// The condition in plain words, e.g. "imported goods" for a goods
  /// declaration. Read by a person, not evaluated by the system — an
  /// automatically-evaluated condition nobody can see is worse than a stated one
  /// somebody answers.
  condition String?

  sequence Int     @default(0)
  active   Boolean @default(true)

  /// Where this requirement comes from, so it can be traced to the SOP.
  sourceReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  packItems PaymentPackItem[]
  @@unique([entityId, transactionType, documentTypeId])
  @@index([transactionType, active])
}

/// One document's standing in a payment pack.
///
/// The checklist has to record more than presence. A conditional document that
/// does not apply is satisfied; one that applies and is missing is a blocker;
/// one that is present but unverified is not yet evidence. And a payment that
/// proceeds without a mandatory document needs somebody's name against the
/// exception, or the control is decorative.
model PaymentPackItem {
  id String @id @default(cuid())

  /// The invoice or petty cash request the pack belongs to.
  documentType String
  documentId   String

  requirementId String?
  requirement   PaymentPackRequirement? @relation(fields: [requirementId], references: [id])

  /// Copied from the requirement so the row stands alone in an audit.
  documentTypeCode String
  documentTypeName String
  requirementKind  String @default("ALWAYS")

  /// Whether the assembler says a conditional requirement applies here.
  applicable    Boolean @default(true)
  applicableNote String?

  /// The attached document, once there is one.
  attachedDocumentId String?
  attachedAt         DateTime?

  verifiedById String?
  verifiedBy   User?     @relation("PaymentPackVerifiedBy", fields: [verifiedById], references: [id])
  verifiedAt   DateTime?

  /// Set when a mandatory document is waived. Both the reason and the person are
  /// required — a waiver with neither is indistinguishable from an oversight.
  exceptionReason       String?
  exceptionApprovedById String?
  exceptionApprovedBy   User?     @relation("PaymentPackExceptionBy", fields: [exceptionApprovedById], references: [id])
  exceptionApprovedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentType, documentId, documentTypeCode])
  @@index([documentType, documentId])
}

/// One receipt's worth of stock at the price that receipt was bought at.
///
/// The bucket carries a single weighted-average `unitCost`, which answers "what
/// is this stock worth on average" but cannot answer "what did the units we just
/// issued actually cost". Ten at 100 followed by ten at 120 averages to 110, and
/// an issue of twelve is then valued at 1,320 — where FIFO says 10x100 + 2x120 =
/// 1,240. The difference is real money and it lands in cost of sales.
///
/// So each inbound movement opens a layer, and each outbound movement consumes
/// layers oldest-first, recording which layer each unit came from.
///
/// This is deliberately NOT the same thing as FEFO picking. FEFO decides which
/// physical carton leaves the shelf, and it must keep ordering by expiry, because
/// issuing the cheapest stock while the earliest-expiring stock rots would be a
/// worse outcome than a costing discrepancy. FIFO decides what that carton is
/// carried at. The two run side by side and can legitimately disagree.
model CostLayer {
  id String @id @default(cuid())

  itemId  String
  item    Item   @relation(fields: [itemId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  /// The layer belongs to one bucket, so batch-tracked stock keeps its layers
  /// separate from untracked stock of the same item.
  batchNumber  String?
  serialNumber String?

  unitCost          Float
  quantityReceived  Float
  quantityRemaining Float

  /// When the stock arrived. FIFO order is this, then `sequence` for receipts
  /// landing in the same instant.
  receivedAt DateTime
  sequence   Int      @default(0)

  /// The movement that opened the layer, so a layer can always be traced back.
  sourceType    String
  sourceId      String?
  sourceRef     String?
  transactionId String?
  grnId         String?

  entityId String?

  /// Set when the layer runs out. Kept rather than deleted: an exhausted layer is
  /// the evidence for every issue that drew on it.
  closedAt DateTime?

  consumptions CostLayerConsumption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId, storeId, receivedAt])
  @@index([itemId, storeId, quantityRemaining])
  @@index([transactionId])
  @@map("cost_layers")
}

/// What one outbound movement took from one layer, at what price.
///
/// An issue of twelve against layers of ten and ten produces two rows, not an
/// averaged one. The rows are what make the cost auditable — without them the
/// FIFO figure is an assertion.
model CostLayerConsumption {
  id String @id @default(cuid())

  layerId String
  layer   CostLayer @relation(fields: [layerId], references: [id])

  /// The outbound InventoryTransaction this consumption belongs to.
  transactionId String

  quantity Float
  unitCost Float
  value    Float

  consumedAt DateTime @default(now())

  @@index([transactionId])
  @@index([layerId])
  @@map("cost_layer_consumptions")
}

/// Who inspects what, from the Store Process Flow chart.
///
/// ZAM/PUR/SOP-01, Store – Process Flow, Goods Receiving Flow step 2 prints a
/// twenty-one cell chart: three inspection types down the side, seven category
/// groups across the top, and Store / Admin / IT in the cells. The system had a
/// single `inspectionType` defaulting to `GENERAL` and routed everything to one
/// technical inspector, so an Admin sign-off on furniture and an IT sign-off on
/// mobiles simply did not exist.
///
/// The chart is data, not code, because it is the sort of thing that changes by
/// memo. Each row cites the cell it came from.
model InspectionResponsibility {
  id String @id @default(cuid())

  /// Null applies to every entity.
  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// The chart's column heading, verbatim.
  categoryGroup String

  /// TECHNICAL | QUALITATIVE | QUANTITATIVE — the chart's three rows.
  inspectionType String

  /// STORE | ADMIN | IT — what the cell says.
  ownerFunction String

  /// The system role that function resolves to. Null means the function has no
  /// role yet, which is a gap to be filled rather than a reason to route the
  /// inspection somewhere else.
  ownerRoleCode String?

  sequence        Int     @default(0)
  active          Boolean @default(true)
  sourceReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entityId, categoryGroup, inspectionType])
  @@index([categoryGroup, active])
  @@map("inspection_responsibilities")
}

/// One required sign-off on one inspection.
///
/// The chart can name three different functions for a single delivery — Admin
/// for the technical and qualitative check on furniture, Store for the count —
/// and §4.7 says the form is "filled and signed by all concerns". One
/// `signedByName` text field could hold one name, so the other two concerns had
/// nowhere to sign and no way to be chased.
///
/// The rows are written when the inspection is scheduled, from the matrix as it
/// stood at that moment. A later change to the chart does not silently rewrite
/// who was supposed to have signed an inspection that already happened.
model InspectionSignoff {
  id String @id @default(cuid())

  inspectionId String
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)

  inspectionType String
  ownerFunction  String
  ownerRoleCode  String?

  /// PASS | FAIL | CONDITIONAL — this function's own verdict, which is not
  /// necessarily the inspection's overall one.
  verdict String?
  notes   String?

  signedById String?
  signedBy   User?     @relation("InspectionSignoffBy", fields: [signedById], references: [id])
  signedAt   DateTime?

  /// The attestation this sign-off produced, so the signature and its hash live
  /// where every other signature in the system lives.
  attestationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([inspectionId, inspectionType])
  @@index([inspectionId])
  @@map("inspection_signoffs")
}

/// Negotiation Minutes.
///
/// ZAM/PUR/SOP-01 §4.5.1: "A price negotiating call or meeting will be conducted
/// by procurement department with the vendors. Negotiation will be based on;
/// financial evaluation/competitive price, payment terms, product/ service
/// quality, on time delivery, after sales services, warranties etc.
/// **Preparation of Comparative Statement, Negotiation Minutes, approval
/// documents and conclusion is to be documented.**"
///
/// The system recorded negotiation *rounds* — a number moving from one figure to
/// another — which is the outcome of a negotiation and not the minutes of one.
/// The minutes are what say who was in the room, what was discussed against each
/// of the six bases the SOP names, and what was concluded. A price that fell by
/// eight per cent with no record of what was conceded to get there is a number
/// nobody can defend to an auditor.
model NegotiationMinute {
  id     String @id @default(cuid())
  number String @unique

  /// The sourcing exercise these minutes belong to.
  rfqId String?
  rfq   Rfq?    @relation(fields: [rfqId], references: [id])
  prId  String?
  pr    PurchaseRequisition? @relation(fields: [prId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// CALL | MEETING | EMAIL | PORTAL | WHATSAPP — §4.5.1 allows a call or a
  /// meeting; the others are here because the petty cash clause allows written
  /// quotations over social media and the same evidence problem applies.
  channel  String   @default("CALL")
  heldAt   DateTime
  location String?

  /// DRAFT | FINALISED — finalised minutes are the record; a draft is not.
  status String @default("DRAFT")

  /// What was concluded. §4.5.1 requires the conclusion to be documented, and a
  /// set of minutes with no conclusion documents a conversation, not a decision.
  conclusion String?

  /// The vendor the minutes conclude for, where they conclude for one.
  recommendedVendorId String?
  recommendedVendor   Vendor? @relation(fields: [recommendedVendorId], references: [id])

  preparedById String
  preparedBy   User   @relation("MinutePreparedBy", fields: [preparedById], references: [id])

  finalisedAt DateTime?

  participants NegotiationParticipant[]
  bases        NegotiationBasisNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([status])
  @@map("negotiation_minutes")
}

/// Who was in the room, on which side.
///
/// Held as rows rather than a free-text list because "who attended" is the fact
/// an auditor asks about first, and a sentence cannot be queried. A vendor
/// representative is usually not a system user, so the name is captured as
/// written rather than joined.
model NegotiationParticipant {
  id       String            @id @default(cuid())
  minuteId String
  minute   NegotiationMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)

  /// COMPANY | VENDOR
  side String

  userId   String?
  user     User?   @relation("MinuteParticipant", fields: [userId], references: [id])
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  name        String
  designation String?
  attended    Boolean @default(true)

  @@index([minuteId])
  @@map("negotiation_participants")
}

/// What was discussed against one of the SOP's named negotiation bases.
///
/// §4.5.1 lists six and then says "etc.", so the list is open rather than
/// closed — `OTHER` exists for that, and it must be labelled.
model NegotiationBasisNote {
  id       String            @id @default(cuid())
  minuteId String
  minute   NegotiationMinute @relation(fields: [minuteId], references: [id], onDelete: Cascade)

  /// PRICE | PAYMENT_TERMS | QUALITY | DELIVERY | AFTER_SALES | WARRANTY | OTHER
  basis String
  /// Set for OTHER, so an unnamed basis cannot hide in the list.
  label String?

  /// False where the basis was not discussed. Recorded rather than omitted: a
  /// negotiation that never raised payment terms is a fact worth having.
  discussed Boolean @default(true)
  notes     String?

  sequence Int @default(0)

  @@unique([minuteId, basis, label])
  @@index([minuteId])
  @@map("negotiation_basis_notes")
}

/// Work Orders.
///
/// ZAM/PUR/SOP-01 gives them two clauses, and both matter.
///
/// **§4.6** — "Work order is to be issued by the **Admin department** on the
/// basis of **rates negotiated by Procurement**." Two different departments in
/// one sentence: procurement gets the rate, admin raises the order. That split
/// is the control, and it is why a work order is not just a purchase order with
/// a different name.
///
/// **CPC ToR, Services Acquisition for Admin** — "Any acquisition of services
/// not falling under the domain of Central Purchase Committee (CPC) will fall
/// under the domain of admin. However, **before raising any work order it needs
/// to be reviewed and approved by Internal Audit Department before the
/// finalization of the order.**"
///
/// So a work order below the committee threshold has its own gate — Internal
/// Audit — which nothing else in the system has. Above the threshold the
/// committee governs and the CPC case is the review; the SOP puts the IA gate on
/// what falls *outside* CPC, so applying it to both would be inventing a second
/// review the SOP does not ask for.
model WorkOrder {
  id     String @id @default(cuid())
  number String @unique

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// Where the rates came from. §4.6 makes procurement's negotiated rate the
  /// basis of the order, so the order points at it rather than restating it from
  /// memory.
  prId                String?
  pr                  PurchaseRequisition? @relation(fields: [prId], references: [id])
  rfqId               String?
  rfq                 Rfq?                 @relation(fields: [rfqId], references: [id])
  comparativeId       String?
  comparative         Comparative?         @relation(fields: [comparativeId], references: [id])
  negotiationMinuteId String?

  title       String
  scopeOfWork String

  departmentId String?
  projectId    String?
  siteId       String?

  currency  String @default("PKR")
  subtotal  Float  @default(0)
  taxAmount Float  @default(0)
  total     Float  @default(0)

  /// DRAFT | PENDING_INTERNAL_AUDIT | PENDING_APPROVAL | APPROVED | ISSUED
  /// | IN_PROGRESS | COMPLETED | CLOSED | CANCELLED
  status String @default("DRAFT")

  /// Whether the CPC ToR's Internal Audit review applies to this one, decided
  /// from the value against the committee threshold at the moment it is raised
  /// and then held. A threshold change later must not retrospectively make a
  /// signed order look ungated.
  internalAuditRequired Boolean @default(false)
  /// NOT_REQUIRED | PENDING | APPROVED | REJECTED
  internalAuditStatus   String  @default("NOT_REQUIRED")
  internalAuditById     String?
  internalAuditBy       User?     @relation("WorkOrderAudit", fields: [internalAuditById], references: [id])
  internalAuditAt       DateTime?
  internalAuditNotes    String?

  /// Admin raises and issues it — §4.6.
  createdById String
  createdBy   User      @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])
  issuedById  String?
  issuedBy    User?     @relation("WorkOrderIssuedBy", fields: [issuedById], references: [id])
  issuedAt    DateTime?

  startDate     DateTime?
  endDate       DateTime?
  completedAt   DateTime?
  closedAt      DateTime?
  cancelledAt   DateTime?
  closureReason String?

  items WorkOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([vendorId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  lineNo      Int
  description String
  quantity    Float  @default(1)
  unit        String @default("JOB")
  rate        Float  @default(0)
  amount      Float  @default(0)

  /// The quotation line or negotiated rate this one came from, so a rate on a
  /// work order can be traced to the negotiation that produced it.
  sourceRef String?

  @@unique([workOrderId, lineNo])
  @@map("work_order_items")
}

/// The Price Competitiveness Policy, per sourcing exercise.
///
/// ZAM/PUR/SOP-01 has a named policy with a named procedure, and the system
/// implemented none of it as a control. Its steps, verbatim:
///
/// > Last buying price will be reviewed · For imported items international and
/// > local market prices will be analyzed through authorized
/// > suppliers/distributors · **Single sourcing options will be evaluated based
/// > on the volumes** · Check International Prices (for imported items) · Check
/// > Prices from Local Vendor/Clients · **Multiple sourcing options will be
/// > evaluated based on the volumes** · **Minimum of 3 quotations from approved
/// > vendors** · Cost Analysis Summary · New vendor inductions completing all
/// > pertinent prerequisites · **For emergency purchases price competitiveness
/// > may not be considered in detail.**
///
/// Three things about that list decide the shape of this model.
///
/// **Some steps are conditional on the goods.** The international-price checks
/// apply "for imported items" and to nothing else. A checklist that demands them
/// on a local purchase of stationery would be ignored within a week, and an
/// ignored checklist is worse than none.
///
/// **Single and multiple sourcing are both legitimate**, and the SOP says which
/// applies is "evaluated based on the volumes". So the basis is recorded with the
/// reasoning, rather than single sourcing being an exception to be justified away.
/// What the SOP does not permit is silence: a single-sourced award with no volume
/// rationale is the one case this refuses.
///
/// **Emergency relaxes, it does not waive.** "Price competitiveness may not be
/// considered in detail" is a relaxation of the detailed analysis — the
/// international and local price studies, and the three-quotation minimum. It is
/// not permission to skip the last buying price, the cost analysis or the vendor
/// prerequisites, and it is not permission to skip saying why. So the exemption
/// is named, approved, and records exactly which steps it excused.
model PriceCompetitivenessReview {
  id String @id @default(cuid())

  comparativeId String      @unique
  comparative   Comparative @relation(fields: [comparativeId], references: [id], onDelete: Cascade)
  prId          String?
  entityId      String?

  /// Whether the imported-item branch of the procedure applies at all.
  imported Boolean @default(false)

  /// SINGLE | MULTIPLE — which sourcing route the volumes point to.
  sourcingBasis   String  @default("MULTIPLE")
  /// Why the volumes point that way. Required for a single-sourced award: the
  /// SOP permits single sourcing on the volumes, not on nothing.
  volumeRationale String?

  /// "Last buying price will be reviewed."
  lastBuyingPriceReviewed Boolean @default(false)
  lastBuyingPrice         Float?
  lastBuyingPriceSource   String?

  /// "Check International Prices (for imported items)."
  internationalPricesChecked Boolean @default(false)
  internationalPriceNote     String?

  /// "Check Prices from Local Vendor/Clients (both for imported and local items)."
  localPricesChecked Boolean @default(false)
  localPriceNote     String?

  /// "Minimum of 3 quotations from approved vendors." Held as a snapshot so the
  /// review says what was true when it was taken, not what is true now.
  quotationsObtained Int @default(0)
  minimumRequired    Int @default(3)

  /// "Cost Analysis Summary."
  costAnalysisAttached Boolean @default(false)

  /// "New vendor inductions completing all pertinent prerequisites." Null where
  /// no new vendor is involved — which is not the same as unanswered.
  newVendorInvolved         Boolean @default(false)
  newVendorPrerequisitesMet Boolean?

  /// The emergency relaxation, and what it excused.
  emergencyExempt       Boolean   @default(false)
  emergencyReason       String?
  emergencyApprovedById String?
  emergencyApprovedBy   User?     @relation("PriceCompEmergencyBy", fields: [emergencyApprovedById], references: [id])
  emergencyApprovedAt   DateTime?
  /// JSON list of the step codes the exemption excused, recorded at the moment
  /// it was granted. A later change to what emergency relaxes must not rewrite
  /// what a past award was excused from.
  emergencyExcused      String    @default("[]")

  preparedById String
  preparedBy   User   @relation("PriceCompPreparedBy", fields: [preparedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([prId])
  @@map("price_competitiveness_reviews")
}

/// Who was present when the scrap was sold.
///
/// ZAM/PUR/SOP-01: "Scrap activity will be done in the presence of IA, Finance,
/// Admin, Procurement and Logistics." Five functions, named, and the point of
/// naming five is that no one of them can conduct the sale alone.
///
/// Rows rather than a checkbox, because "who was there" is the question asked
/// about a disposal that later looks wrong, and a boolean cannot answer it.
model DisposalWitness {
  id         String       @id @default(cuid())
  disposalId String
  disposal   DisposalCase @relation(fields: [disposalId], references: [id], onDelete: Cascade)

  /// INTERNAL_AUDIT | FINANCE | ADMIN | PROCUREMENT | LOGISTICS
  function String

  userId String?
  user   User?   @relation("DisposalWitnessUser", fields: [userId], references: [id])
  /// The name as given, for somebody who is not a system user.
  name        String?
  designation String?

  attendedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())

  @@unique([disposalId, function])
  @@index([disposalId])
  @@map("disposal_witnesses")
}

/// A physical stock count.
///
/// ZAM/PUR/SOP-01: "Internal auditor audits the store on monthly basis, to
/// monitor stock and inventory status." The system had no count of any kind, so
/// the ledger had never been checked against a shelf — which is the only thing
/// that tells you whether the ledger is true.
///
/// Three decisions in the shape of this.
///
/// **The expected quantity is frozen when the sheet is opened.** Counting takes
/// hours and stock keeps moving; comparing a hand count taken at ten o'clock
/// against a balance read at four in the afternoon manufactures variances that
/// are really just movements. The sheet records what the ledger said at the
/// moment it was cut, and any movement afterwards is visible as a movement
/// rather than as a discrepancy.
///
/// **A variance is not an adjustment.** Finding a difference and correcting the
/// ledger are two acts by two people. The count records what was found; the
/// adjustment posts through `postMovement` like every other stock change, with a
/// reason, and only after somebody has approved it. A count that silently
/// corrected the ledger would destroy the evidence it exists to create.
///
/// **Zero is a count.** A line left blank has not been counted; a line counted
/// as zero has. Collapsing the two would let an uncounted shelf read as an empty
/// one, which is the single most useful thing a count can catch.
model StockCount {
  id     String @id @default(cuid())
  number String @unique

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// FULL | CYCLE | SPOT — a full count covers the store, a cycle count a slice
  /// of it on a rota, a spot count one thing somebody is suspicious about.
  countType String @default("CYCLE")

  /// DRAFT | COUNTING | REVIEW | APPROVED | ADJUSTED | CLOSED | CANCELLED
  status String @default("DRAFT")

  /// What the count was scoped to, for a cycle or spot count.
  categoryId String?
  locationId String?
  scopeNote  String?

  /// Frozen when the sheet is cut. Every line's expected quantity is as at this
  /// moment, and the screen says so.
  snapshotAt DateTime?

  countedById String?
  countedBy   User?     @relation("StockCountCountedBy", fields: [countedById], references: [id])
  countedAt   DateTime?

  /// The SOP puts the monthly store audit with Internal Audit, so the review is
  /// a separate signature from the count.
  reviewedById String?
  reviewedBy   User?     @relation("StockCountReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  reviewNotes  String?

  approvedById String?
  approvedBy   User?     @relation("StockCountApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime?

  adjustedAt DateTime?
  closedAt   DateTime?

  createdById String
  createdBy   User   @relation("StockCountCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines StockCountLine[]

  @@index([storeId, status])
  @@index([status])
  @@map("stock_counts")
}

model StockCountLine {
  id      String     @id @default(cuid())
  countId String
  count   StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)

  lineNo Int

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// The bucket this line counts, so batch-tracked stock is counted per batch.
  inventoryItemId String?
  batchNumber     String?
  serialNumber    String?
  locationId      String?

  unit String @default("EA")

  /// What the ledger said when the sheet was cut.
  expectedQty  Float @default(0)
  expectedCost Float @default(0)

  /// What was found. Null means not counted; zero means counted and empty, and
  /// the two are deliberately different.
  countedQty Float?

  /// countedQty less expectedQty, held rather than computed on read so the sheet
  /// says what it said when it was signed.
  varianceQty   Float?
  varianceValue Float?

  /// Why the variance happened, in the counter's words. Required on any line
  /// that differs: an unexplained variance is a number nobody can act on.
  varianceReason String?

  /// The ledger movement that corrected this line, once one has been posted.
  adjustmentTxnId String?

  notes String?

  @@unique([countId, lineNo])
  @@index([countId])
  @@map("stock_count_lines")
}

/// An employee handing something back to the store.
///
/// ZAM/PUR/SOP-01, Store Keeping, prints three routes into a store — New Items,
/// **Employee Return**, and Asset Tagging — and gives the employee-return route
/// its own flow:
///
/// > Store Receiving note · Inspection (**Only IT equipment will be inspected**)
/// > · Fails inspection; sent to the Repair and Maintenance Dept · Pass
/// > Inspection; Store Manager will proceed to the next step i.e. Stacking &
/// > Inventory
///
/// The system had nothing for this. Custody sat on the asset and could be
/// reassigned, which recorded that somebody else now holds it but not that
/// anything came back, in what condition, or whether it was fit to reissue.
///
/// Two details from that flow are load-bearing.
///
/// **Only IT equipment is inspected.** So the inspection is conditional, and
/// what makes it conditional is the item, not somebody's judgement on the day.
/// A returned chair does not wait on an IT inspection it will never get.
///
/// **A failed inspection goes to Repair and Maintenance, not back on the
/// shelf.** That is the whole point of inspecting: the alternative is a broken
/// laptop reissued to the next joiner. So a failed unit is handed off and the
/// hand-off is recorded, rather than the return simply being marked closed.
model EmployeeReturn {
  id     String @id @default(cuid())
  number String @unique

  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// Who is handing it back. Held as a user where they are one, and by name
  /// either way, because a leaver's account is often already disabled by the
  /// time their equipment comes back.
  returnedById String?
  returnedBy   User?   @relation("EmployeeReturnBy", fields: [returnedById], references: [id])
  returnedByName String
  department     String?

  /// RESIGNATION | TRANSFER | ROLE_CHANGE | UPGRADE | FAULTY | END_OF_PROJECT | OTHER
  reason      String  @default("OTHER")
  reasonNote  String?

  /// DRAFT | RECEIVED | PENDING_INSPECTION | INSPECTION_FAILED | AT_REPAIR
  /// | ACCEPTED | STACKED | CLOSED | CANCELLED
  status String @default("DRAFT")

  /// The Store Receiving Note — the first step of the SOP's flow.
  srnNumber   String?
  receivedById String?
  receivedBy   User?     @relation("EmployeeReturnReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime?
  receiptNotes String?

  /// Whether the IT inspection applies, decided from the items when the note is
  /// raised and then held.
  inspectionRequired Boolean @default(false)
  inspectionId       String?
  inspectedById      String?
  inspectedBy        User?     @relation("EmployeeReturnInspectedBy", fields: [inspectedById], references: [id])
  inspectedAt        DateTime?
  inspectionResult   String?
  inspectionNotes    String?

  /// The Repair and Maintenance hand-off, for anything that failed.
  repairHandoffAt   DateTime?
  repairHandoffRef  String?
  repairHandoffNote String?

  stackedAt DateTime?
  closedAt  DateTime?

  createdById String
  createdBy   User   @relation("EmployeeReturnCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items EmployeeReturnItem[]

  @@index([storeId, status])
  @@index([status])
  @@map("employee_returns")
}

model EmployeeReturnItem {
  id       String         @id @default(cuid())
  returnId String
  return   EmployeeReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  lineNo Int

  /// Either a tagged asset coming back, or a catalogue item, or something with
  /// neither — a cable somebody was issued years ago. All three happen.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])
  itemId  String?
  item    Item?   @relation(fields: [itemId], references: [id])

  description String
  quantity    Float  @default(1)
  unit        String @default("EA")
  serialNumber String?

  /// GOOD | USABLE | DAMAGED | FAULTY | BEYOND_REPAIR — what the store received,
  /// as received, before any inspection.
  condition      String  @default("GOOD")
  conditionNotes String?

  /// Set once the unit has been inspected, where inspection applies.
  /// PASS | FAIL | NOT_INSPECTED
  inspectionVerdict String?

  /// STACK | REPAIR | DISPOSE | HOLD — where this unit went. Recorded per line,
  /// because one return can hold a working monitor and a dead laptop.
  disposition     String?
  dispositionNote String?

  /// The movement that took it back into stock, where it went back into stock.
  movementTxnId String?

  @@unique([returnId, lineNo])
  @@index([returnId])
  @@map("employee_return_items")
}

/// A recurring control and when it is next due.
///
/// The meeting requirements ask for a control calendar. The SOP scatters
/// recurring obligations through its text — the internal auditor audits the
/// store monthly, monthly repeat requisitions are compiled, vendor performance
/// is evaluated, pre-qualifications expire — and nothing in the system knew any
/// of them were due, so each depended on somebody remembering.
///
/// A control is a row: what it is, who owns it, how often, when it was last
/// done, when it is next due. Owned by a **role** rather than a person, because
/// people leave and the control does not; the run names the individual.
model ControlDefinition {
  id   String @id @default(cuid())
  code String @unique

  name        String
  description String?

  /// Where the obligation comes from, so nobody has to guess whether a control
  /// is policy or somebody's preference.
  sourceReference String?

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// DAILY | WEEKLY | MONTHLY | QUARTERLY | HALF_YEARLY | ANNUAL
  frequency String @default("MONTHLY")

  /// The role that owns it. A named person would leave with them.
  ownerRoleCode String?

  /// Days after the period ends before it is late.
  graceDays Int @default(5)

  /// Where somebody goes to do it.
  actionUrl String?

  active          Boolean @default(true)
  /// Set when the control exists in policy but is not yet being run, so the
  /// calendar can show what it is not doing rather than hiding it.
  awaitingRollout Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs ControlRun[]

  @@index([active, frequency])
  @@map("control_definitions")
}

/// One period of one control, and what happened in it.
///
/// A run is created for the period rather than when somebody acts, so a control
/// nobody performed is a row with nothing in it — which is the whole point. A
/// calendar that only holds what was done cannot tell you what was not.
model ControlRun {
  id           String            @id @default(cuid())
  definitionId String
  definition   ControlDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  /// The period this run covers, as a label somebody reads: "2026-08", "2026-Q3".
  periodLabel String
  periodStart DateTime
  periodEnd   DateTime
  dueAt       DateTime

  /// DUE | COMPLETED | MISSED | WAIVED | NOT_APPLICABLE
  status String @default("DUE")

  performedById String?
  performedBy   User?     @relation("ControlRunPerformedBy", fields: [performedById], references: [id])
  performedAt   DateTime?
  evidenceRef   String?
  notes         String?

  /// A control not performed is either missed or excused, and an excuse has a
  /// name against it.
  waivedById String?
  waivedBy   User?     @relation("ControlRunWaivedBy", fields: [waivedById], references: [id])
  waivedAt   DateTime?
  waiverReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([definitionId, periodLabel])
  @@index([status, dueAt])
  @@map("control_runs")
}

/// Contracts and agreements.
///
/// ZAM/PUR/SOP-01 §4.6: "Procurement department will **solely** be authorized to
/// issue purchase order, **contract, agreement** or any other related documents
/// mentioning all necessary details related to payment term, delivery location,
/// etc with the signature of Manager Procurement or other authorized signatory."
///
/// The system had purchase orders and nothing else. A twelve-month AMC lived as
/// either a single purchase order — which closes when its first invoice is paid,
/// taking the obligation with it — or as nothing at all.
///
/// The CPC's mandate names the types: "SLA · Service Contracts · AMC (Annual
/// Maintenance contract) · Buildouts · Onetime Purchases", and the committee
/// approves any contract over PKR 500,000 "based on technical, financial and
/// legal implications". So the type is a real classification with real
/// consequences, not a label.
///
/// ## What a contract is that a purchase order is not
///
/// A **standing obligation with an end date**. That is the whole distinction, and
/// it produces the two things this model exists for: an expiry that has to be
/// seen coming, and a value that is drawn down over time by many orders rather
/// than consumed by one.
model Contract {
  id     String @id @default(cuid())
  number String @unique

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  title       String
  description String?

  /// SLA | SERVICE_CONTRACT | AMC | BUILDOUT | ONE_TIME | RENTAL | FRAMEWORK | OTHER
  ///
  /// The first five are the CPC mandate's own list. RENTAL is here because the
  /// SOP gives rental agreements their own committee, and FRAMEWORK because a
  /// rate agreement with no committed value is a real thing that is none of the
  /// others. OTHER exists so nothing has to be mislabelled to be recorded.
  contractType String @default("SERVICE_CONTRACT")

  /// DRAFT | PENDING_REVIEW | PENDING_APPROVAL | APPROVED | PENDING_SIGNATURE
  /// | ACTIVE | EXPIRING | EXPIRED | RENEWED | SUSPENDED | TERMINATED | CLOSED
  ///
  /// Twelve states, each a distinct condition somebody would describe
  /// differently. EXPIRING is not cosmetic: a contract inside its notice period
  /// needs a decision, and one that has run out needs a different one.
  status String @default("DRAFT")

  currency String @default("PKR")
  /// What the contract commits to, where it commits to an amount. A framework
  /// agreement on rates commits to none, and a zero here means exactly that
  /// rather than "unknown".
  contractValue Float?
  /// Drawn down by the orders raised against it.
  committedValue Float @default(0)

  startDate DateTime?
  endDate   DateTime?

  /// Days before `endDate` at which the contract starts asking for a decision.
  noticeDays Int @default(60)

  /// Whether it rolls on unless somebody stops it. An auto-renewing contract
  /// nobody is watching is the one that costs money after it stops being needed.
  autoRenew      Boolean @default(false)
  renewalOfId    String?
  renewalOf      Contract?  @relation("ContractRenewal", fields: [renewalOfId], references: [id])
  renewals       Contract[] @relation("ContractRenewal")

  paymentTerms     String?
  deliveryLocation String?
  legalTerms       String?
  slaTerms         String?

  /// §4.6 — the authorised signatory who issued it, and when.
  authorisedSignatoryId String?
  authorisedSignatory   User?     @relation("ContractSignatory", fields: [authorisedSignatoryId], references: [id])
  signedAt              DateTime?
  vendorSignedAt        DateTime?
  vendorSignatoryName   String?

  /// The committee case, where the value took it to one. Held so a contract can
  /// show its own approval rather than the approval having to be found.
  cpcCaseId String?
  prId      String?
  pr        PurchaseRequisition? @relation(fields: [prId], references: [id])

  /// Set when the committee's approval was required and obtained, decided from
  /// the value at the moment the contract was raised and then held.
  committeeRequired Boolean @default(false)

  terminatedAt     DateTime?
  terminationReason String?
  closedAt         DateTime?
  statusReason     String?

  createdById String
  createdBy   User   @relation("ContractCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events ContractEvent[]

  @@index([status, endDate])
  @@index([vendorId])
  @@map("contracts")
}

/// One thing that happened to a contract.
///
/// Kept as its own trail rather than only in the audit log, because a contract's
/// history is a business document people read — when it was signed, when it was
/// renewed, when somebody was warned it was running out — and an audit log is a
/// forensic record that happens to contain that.
model ContractEvent {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  /// CREATED | REVIEWED | APPROVED | SIGNED | ACTIVATED | NOTICE_GIVEN
  /// | EXPIRY_WARNED | RENEWED | SUSPENDED | RESUMED | TERMINATED | CLOSED | AMENDED
  eventType String
  fromStatus String?
  toStatus   String?
  note       String?

  actorId String?
  actor   User?   @relation("ContractEventActor", fields: [actorId], references: [id])

  occurredAt DateTime @default(now())

  @@index([contractId, occurredAt])
  @@map("contract_events")
}

/// A recorded delegation of authority.
///
/// The meeting requirements ask for delegation and proxy that is **provable**,
/// rather than "someone else holds the permission". Today the only way to keep
/// approvals moving while an approver is away is to give somebody their role —
/// which is permanent until removed, invisible afterwards, and indistinguishable
/// from that person having always held it.
///
/// A delegation is instead a dated grant from one named person to another,
/// bounded in time and scope, and every act taken under it says so.
///
/// ## Four things that make it a control rather than a shortcut
///
/// **It is bounded in time.** A delegation with no end date is a role
/// reassignment wearing a delegation's name, so `validTo` is required.
///
/// **It is granted by the person whose authority it is.** Somebody delegating an
/// authority they do not hold is not delegating, and an administrator handing out
/// somebody else's authority is not either — so a grant needs a reason and names
/// who recorded it separately from whose authority it is.
///
/// **It is scoped.** A delegation of purchase-order approval is not a delegation
/// of everything, and an "all authority" delegation is the thing that makes
/// separation of duties unenforceable for its duration.
///
/// **Acts under it are attributed to both.** The delegate acted; the delegator's
/// authority was used. An approval that records only one of those cannot be
/// audited.
model Delegation {
  id String @id @default(cuid())

  /// Whose authority is being lent.
  delegatorId String
  delegator   User   @relation("DelegationFrom", fields: [delegatorId], references: [id])
  /// Who may use it.
  delegateId  String
  delegate    User   @relation("DelegationTo", fields: [delegateId], references: [id])

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// The permissions being lent, as JSON. Empty is refused: a delegation of
  /// nothing is not a delegation, and a delegation of everything is what makes
  /// segregation of duties unenforceable while it lasts.
  permissions String @default("[]")

  /// Optional narrowing to particular document types, e.g. ["PR","PO"].
  documentTypes String @default("[]")

  /// A ceiling on what may be approved under it, where one applies. Null means
  /// the delegator's own limits stand.
  valueLimit Float?

  validFrom DateTime
  validTo   DateTime

  reason String

  /// PENDING | ACTIVE | EXPIRED | REVOKED
  status String @default("ACTIVE")

  /// Who entered it, which is not necessarily whose authority it is.
  recordedById String
  recordedBy   User   @relation("DelegationRecordedBy", fields: [recordedById], references: [id])

  revokedById String?
  revokedBy   User?     @relation("DelegationRevokedBy", fields: [revokedById], references: [id])
  revokedAt   DateTime?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  uses DelegationUse[]

  @@index([delegateId, status])
  @@index([delegatorId, status])
  @@index([status, validTo])
  @@map("delegations")
}

/// One act taken under a delegation.
///
/// Recorded so the delegation is provable after the fact. An approval given
/// under borrowed authority that does not say so is indistinguishable from one
/// given by somebody who held the authority outright, and that is precisely the
/// distinction an auditor is looking for.
model DelegationUse {
  id           String     @id @default(cuid())
  delegationId String
  delegation   Delegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)

  action       String
  documentType String
  documentId   String
  documentRef  String?

  usedById String
  usedBy   User   @relation("DelegationUsedBy", fields: [usedById], references: [id])
  usedAt   DateTime @default(now())

  @@index([delegationId, usedAt])
  @@index([documentType, documentId])
  @@map("delegation_uses")
}

/// Somebody's acknowledgement of a specific version of a policy.
///
/// The meeting requirements ask for acknowledgement "tied to the exact version",
/// which is the whole point: an acknowledgement of "the procurement policy" says
/// nothing once the policy changes, and everybody's acknowledgement silently
/// becomes an acknowledgement of a document they never read.
model PolicyDocument {
  id   String @id @default(cuid())
  code String
  /// The version acknowledged. `code` plus `version` is what somebody signs.
  version String

  title       String
  summary     String?
  /// What changed in this version, so an acknowledgement of it means something
  /// more than "I clicked".
  changeNote  String?

  entityId String?
  entity   Entity? @relation(fields: [entityId], references: [id])

  /// The document itself, where one is attached.
  documentId String?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  /// Roles that must acknowledge it. Empty means everybody.
  requiredRoleCodes String @default("[]")

  active Boolean @default(true)

  createdById String
  createdBy   User   @relation("PolicyCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acknowledgements PolicyAcknowledgement[]

  @@unique([code, version, entityId])
  @@index([active, effectiveFrom])
  @@map("policy_documents")
}

model PolicyAcknowledgement {
  id       String         @id @default(cuid())
  policyId String
  policy   PolicyDocument @relation(fields: [policyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("PolicyAcknowledgedBy", fields: [userId], references: [id])

  /// The office held when they acknowledged it, captured rather than joined —
  /// an acknowledgement is a statement by a person in a role at a moment.
  roleAtAcknowledgement String?

  acknowledgedAt DateTime @default(now())
  ip             String?
  userAgent      String?

  @@unique([policyId, userId])
  @@index([userId])
  @@map("policy_acknowledgements")
}

/// A loss, theft or unexplained shortage.
///
/// The meeting requirements ask for loss and theft reporting. The system had one
/// route for stock that is not there: a manual adjustment with a reason, which
/// makes a shortage look like a correction and buries a theft in the same list
/// as a mis-keyed count.
///
/// The difference matters for three reasons. A theft needs an investigation and
/// possibly a police report; an adjustment does not. A loss has a value that
/// belongs in a monthly figure somebody is accountable for; an adjustment's does
/// not. And a pattern of losses in one store is a finding, which is impossible
/// to see when each one is a line in the adjustment ledger.
///
/// ## What it does not do
///
/// It does not move stock. The ledger correction is a separate, authorised
/// adjustment, and it happens once the case has been reviewed — a report that
/// silently wrote off the stock would let anybody make an inconvenient quantity
/// disappear by filing a form.
model LossReport {
  id     String @id @default(cuid())
  number String @unique

  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  /// THEFT | LOSS | DAMAGE | SHORTAGE_UNEXPLAINED | MISPLACED
  ///
  /// SHORTAGE_UNEXPLAINED is deliberately its own kind. Most shortages are not
  /// known to be theft and calling them so is an accusation; calling them a
  /// loss implies somebody knows what happened. "We cannot account for it" is
  /// the honest third answer and the most common one.
  lossType String @default("SHORTAGE_UNEXPLAINED")

  title       String
  description String

  /// When it is believed to have happened, which is rarely when it was found.
  occurredOn   DateTime?
  discoveredOn DateTime

  /// How it came to light — a count, a customer complaint, a locked cupboard
  /// found open. The route to discovery is often the most useful fact in the file.
  discoveryRoute String?

  /// Where the shortage was measured, when it came from a count.
  stockCountId String?

  /// DRAFT | REPORTED | UNDER_INVESTIGATION | SUBSTANTIATED | UNSUBSTANTIATED
  /// | WRITTEN_OFF | RECOVERED | CLOSED | CANCELLED
  status String @default("DRAFT")

  estimatedValue Float @default(0)
  /// What was actually recovered, where anything was.
  recoveredValue Float @default(0)
  /// The value written off, once the ledger has been corrected.
  writtenOffValue Float?

  /// Whether the police were involved, and the reference if so. A theft reported
  /// internally and never to anybody outside is a different fact from one that
  /// was, and the register should be able to tell them apart.
  policeReported  Boolean @default(false)
  policeReference String?

  /// Whether anybody is suspected. Held as a note rather than a user link on
  /// purpose: naming a person in a structured field turns a suspicion into a
  /// record about them, and the system should not do that on a form entry.
  suspicionNote String?

  reportedById String
  reportedBy   User   @relation("LossReportedBy", fields: [reportedById], references: [id])
  reportedAt   DateTime @default(now())

  investigatorId String?
  investigator   User?     @relation("LossInvestigator", fields: [investigatorId], references: [id])
  investigationStartedAt DateTime?
  findings               String?
  concludedById          String?
  concludedBy            User?     @relation("LossConcludedBy", fields: [concludedById], references: [id])
  concludedAt            DateTime?

  /// The adjustment that took the stock off the ledger, once one was authorised.
  adjustmentTxnIds String @default("[]")
  writtenOffAt     DateTime?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items LossReportItem[]

  @@index([status, discoveredOn])
  @@index([storeId])
  @@map("loss_reports")
}

model LossReportItem {
  id       String     @id @default(cuid())
  reportId String
  report   LossReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  lineNo Int

  itemId  String?
  item    Item?   @relation(fields: [itemId], references: [id])
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id])

  description  String
  quantity     Float  @default(1)
  unit         String @default("EA")
  serialNumber String?
  batchNumber  String?

  unitValue Float @default(0)
  lineValue Float @default(0)

  /// The movement that removed it from the ledger, once one was posted.
  adjustmentTxnId String?

  notes String?

  @@unique([reportId, lineNo])
  @@index([reportId])
  @@map("loss_report_items")
}


/* ─────────────────────────────────────────────────────────────────────────
   Build-outs  ·  ZAM/PUR/SOP-01 Build-Outs section, image21/image23/image24

   A build-out is a new office fitted out by ten departments working to one
   set of deadlines. The SOP's whole point is coordination: a Cross Functional
   Committee is called, each department is handed a predefined checklist, and
   progress is reviewed in a standing Friday meeting until the project closes
   with a lesson-learnt report and a budget-versus-actual variance.

   Modelled as its own thing rather than as a Project with extra fields,
   because a project is a cost-coding dimension and a build-out is a governed
   sequence with meetings, a roster, a checklist and a closing report.
   ───────────────────────────────────────────────────────────────────────── */

model BuildOut {
  id       String @id @default(cuid())
  number   String @unique
  name     String
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  /// CENTRAL | NORTH | SOUTH — the regions the committee rosters are cut by.
  region    String
  city      String?
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
  siteId    String?
  site      Site?    @relation(fields: [siteId], references: [id])

  /// BO-004: what Admin gathered from the departments, Sales especially.
  headcount            Int?
  requirementsSummary  String?
  specialRequirements  String?
  requirementsGatheredById String?
  requirementsGatheredBy   User?     @relation("BuildOutRequirements", fields: [requirementsGatheredById], references: [id])
  requirementsGatheredAt   DateTime?

  /// BO-002: management's go-ahead. A build-out that starts without it is the
  /// thing the first step of the SOP exists to prevent.
  managementApprovedById String?
  managementApprovedBy   User?     @relation("BuildOutManagementApproval", fields: [managementApprovedById], references: [id])
  managementApprovedAt   DateTime?
  managementNote         String?

  /// BO-006: timelines defined early and shared with the committee.
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  timelinesSharedAt DateTime?

  actualStartDate DateTime?
  actualEndDate   DateTime?

  /// BO-010 / BO-014: budget against actual, for the closing variance.
  budgetAmount Float?
  actualAmount Float @default(0)

  /// DRAFT | PENDING_MANAGEMENT | REQUIREMENTS | TIMELINES | CFC_PRESENTED |
  /// IN_EXECUTION | COMPLETED | CLOSED | CANCELLED
  status        String    @default("DRAFT")
  cancelReason  String?
  closedAt      DateTime?
  createdById   String
  createdBy     User      @relation("BuildOutCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks     BuildOutTask[]
  meetings  CfcMeeting[]
  boqLines  BuildOutBoqLine[]
  schedule  BuildOutScheduleDay[]
  lessons   BuildOutLesson[]
  rncCases  RncCase[]

  @@index([entityId, status])
  @@map("build_outs")
}

/// One department's one responsibility on one build-out.
///
/// BO-007 and BO-012: the committee hands each department "a sheet of
/// predefined tasks ... per the Checklist of Roles & Responsibilities". The
/// checklist is a template of 33 named responsibilities across ten departments,
/// seeded from `image24`, and copied onto each build-out so a later edit to the
/// template cannot rewrite what a finished project was asked to do.
model BuildOutTask {
  id         String   @id @default(cuid())
  buildOutId String
  buildOut   BuildOut @relation(fields: [buildOutId], references: [id], onDelete: Cascade)

  /// The department the checklist names, as text — the checklist is the source
  /// and not every entry maps to a department record.
  departmentName String
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])

  responsibility String
  sequence       Int    @default(0)

  ownerId  String?
  owner    User?     @relation("BuildOutTaskOwner", fields: [ownerId], references: [id])
  dueDate  DateTime?

  /// NOT_STARTED | IN_PROGRESS | BLOCKED | DONE | NOT_APPLICABLE
  status       String    @default("NOT_STARTED")
  /// BO-009: the progress note as given in the Friday meeting.
  progressNote String?
  /// Why it does not apply here. A checklist line waved away without a reason
  /// is indistinguishable from one nobody looked at.
  notApplicableReason String?
  completedAt  DateTime?
  updatedById  String?
  updatedBy    User?     @relation("BuildOutTaskUpdatedBy", fields: [updatedById], references: [id])
  updatedAt    DateTime  @updatedAt

  @@index([buildOutId, departmentName])
  @@map("build_out_tasks")
}

/// BO-007, BO-008, BO-009 — the Cross Functional Committee's meetings.
model CfcMeeting {
  id         String   @id @default(cuid())
  number     String   @unique
  buildOutId String
  buildOut   BuildOut @relation(fields: [buildOutId], references: [id], onDelete: Cascade)

  /// KICKOFF — the meeting where scope is presented and the checklist handed out.
  /// WEEKLY  — the standing Friday review.
  /// CLOSING — the lesson-learnt and variance meeting.
  meetingType String   @default("WEEKLY")
  scheduledAt DateTime
  heldAt      DateTime?
  location    String?
  agenda      String?
  minutes     String?

  /// SCHEDULED | HELD | CANCELLED
  status      String @default("SCHEDULED")
  calledById  String?
  calledBy    User?  @relation("CfcMeetingCalledBy", fields: [calledById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance CfcAttendance[]

  @@index([buildOutId, scheduledAt])
  @@map("cfc_meetings")
}

model CfcAttendance {
  id        String     @id @default(cuid())
  meetingId String
  meeting   CfcMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  memberId String
  member   CfcMember @relation(fields: [memberId], references: [id])

  /// PRESENT | PROXY | ABSENT
  attendance String @default("ABSENT")
  /// Who came instead. The roster names a proxy for exactly this, and recording
  /// "present" for a proxy would lose the fact that the member did not attend.
  proxyUserId String?
  proxyUser   User?   @relation("CfcProxyAttended", fields: [proxyUserId], references: [id])
  note        String?

  @@unique([meetingId, memberId])
  @@map("cfc_attendance")
}

/// BO-011 · `image21` — the Cross Functional Team roster, with named proxies.
///
/// A seat belongs to a function, and the roster names both the member and the
/// person who stands in. Held as its own roster rather than derived from roles,
/// because the document names individuals and a role can have many holders.
model CfcMember {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  /// The seat: Sales Central, Finance, HR, IT, Procurement, Internal Audit,
  /// Architect, Legal, Logistic, Administration, Talent Acquisition.
  seat String

  memberId String?
  member   User?   @relation("CfcMemberPrimary", fields: [memberId], references: [id])
  memberName String?

  proxyId   String?
  proxy     User?   @relation("CfcMemberProxy", fields: [proxyId], references: [id])
  proxyName String?

  active   Boolean @default(true)
  sequence Int     @default(0)

  attendance CfcAttendance[]

  @@unique([entityId, seat])
  @@map("cfc_members")
}

/// BO-014 — the bill of quantities, monitored against actual in real time.
model BuildOutBoqLine {
  id         String   @id @default(cuid())
  buildOutId String
  buildOut   BuildOut @relation(fields: [buildOutId], references: [id], onDelete: Cascade)

  lineNo      Int
  description String
  unit        String
  /// What the BOQ said.
  budgetQty   Float
  budgetRate  Float
  budgetTotal Float @default(0)

  /// What was actually measured and paid. BO-014 asks for measurement against
  /// the BOQ after completion, so the two are held side by side rather than
  /// the budget being overwritten.
  actualQty   Float?
  actualRate  Float?
  actualTotal Float?

  varianceNote String?
  measuredById String?
  measuredBy   User?     @relation("BoqMeasuredBy", fields: [measuredById], references: [id])
  measuredAt   DateTime?

  @@unique([buildOutId, lineNo])
  @@map("build_out_boq_lines")
}

/// BO-015 — the day-wise schedule agreed with the vendor, and whether it held.
model BuildOutScheduleDay {
  id         String   @id @default(cuid())
  buildOutId String
  buildOut   BuildOut @relation(fields: [buildOutId], references: [id], onDelete: Cascade)

  day         DateTime
  activity    String
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  vendorName  String?

  /// PLANNED | ON_TRACK | SLIPPED | DONE
  status      String  @default("PLANNED")
  checkedById String?
  checkedBy   User?   @relation("ScheduleCheckedBy", fields: [checkedById], references: [id])
  checkedAt   DateTime?
  slipReason  String?

  @@index([buildOutId, day])
  @@map("build_out_schedule_days")
}

/// BO-010 — the lesson-learnt report: what went wrong, so the next one does not.
model BuildOutLesson {
  id         String   @id @default(cuid())
  buildOutId String
  buildOut   BuildOut @relation(fields: [buildOutId], references: [id], onDelete: Cascade)

  /// COST | TIMELINE | QUALITY | COORDINATION | VENDOR | OTHER
  category  String @default("OTHER")
  finding   String
  /// The improvement it points to. A loophole recorded with no remedy is a
  /// complaint, and the SOP asks for the report to serve future projects.
  recommendation String?

  raisedById String
  raisedBy   User     @relation("LessonRaisedBy", fields: [raisedById], references: [id])
  raisedAt   DateTime @default(now())

  @@index([buildOutId])
  @@map("build_out_lessons")
}

/* ─────────────────────────────────────────────────────────────────────────
   Rental & Negotiation Committee  ·  RNC  ·  image22 + RNC ToR

   RN-001: the mandate covers any transaction including build-outs. RN-004
   sets a quorum the system has to count rather than assume, and RN-010 makes
   the decision a documented email to members copying the CEO's office, with
   the trail Finance needs to pay against.
   ───────────────────────────────────────────────────────────────────────── */

model RncMember {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  /// CENTRAL | NORTH | SOUTH
  region String

  userId String?
  user   User?   @relation("RncMemberUser", fields: [userId], references: [id])
  /// The document names people who may not have accounts yet.
  memberName  String
  designation String?

  /// PERMANENT_MANDATORY — counts toward quorum and must be present or proxied.
  /// PERMANENT           — counts toward quorum.
  /// OBSERVER            — attends, does not vote, does not count.
  memberType String @default("PERMANENT")
  /// The Head of the Committee, who RN-004 requires in addition to the three.
  isHead     Boolean @default(false)

  active   Boolean @default(true)
  sequence Int     @default(0)

  attendance RncAttendance[]
  votes      RncVote[]

  @@unique([entityId, region, memberName])
  @@map("rnc_members")
}

model RncCase {
  id       String @id @default(cuid())
  number   String @unique
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  region String
  title  String
  /// RN-006 — the need assessment for the desired location.
  needAssessment String?
  locationNote   String?

  buildOutId String?
  buildOut   BuildOut? @relation(fields: [buildOutId], references: [id])

  /// RN-008 — whether the agreed terms sit within general market practice, and
  /// the evidence for saying so.
  commercialTerms      String?
  marketPracticeNote   String?
  /// RN-009 — the landlord's own obligations, agreed and written into the deal.
  landlordObligations  String?

  /// DRAFT | PENDING_RNC | DEFERRED | APPROVED | REJECTED | AGREEMENT_SIGNED | CLOSED
  status String @default("DRAFT")

  /// RN-004 — the quorum as it stood when the decision was taken, snapshotted.
  /// The roster changes; whether this decision was quorate must not.
  quorumRequired Int?
  quorumPresent  Int?
  headPresent    Boolean @default(false)
  deferredReason String?

  /// RN-010 — the decision email and the trail Finance pays against.
  decisionEmailRef  String?
  decisionEmailSentAt DateTime?
  ceoOfficeCopied   Boolean @default(false)
  decisionSummary   String?

  decidedAt   DateTime?
  createdById String
  createdBy   User     @relation("RncCaseCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  quotes     RncQuote[]
  votes      RncVote[]
  attendance RncAttendance[]

  @@index([entityId, status])
  @@map("rnc_cases")
}

/// RN-007 — landlord selection on a comparative, not on a single quote.
model RncQuote {
  id     String  @id @default(cuid())
  caseId String
  case   RncCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  landlordName String
  propertyRef  String?
  areaSqft     Float?
  monthlyRent  Float
  annualEscalationPercent Float?
  advanceMonths Int?
  securityDeposit Float?
  leaseYears    Float?

  /// The three things RN-007 names beside price.
  technicalEvaluation    String?
  environmentalImpact    String?
  quoteAnalysisNote      String?

  isSelected Boolean @default(false)
  /// Why this one, when it is not the cheapest.
  selectionReason String?

  @@map("rnc_quotes")
}

model RncAttendance {
  id     String  @id @default(cuid())
  caseId String
  case   RncCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  memberId String
  member   RncMember @relation(fields: [memberId], references: [id])

  /// PRESENT | PROXY | ABSENT
  attendance  String  @default("ABSENT")
  proxyName   String?
  note        String?

  @@unique([caseId, memberId])
  @@map("rnc_attendance")
}

model RncVote {
  id     String  @id @default(cuid())
  caseId String
  case   RncCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  memberId String
  member   RncMember @relation(fields: [memberId], references: [id])

  /// APPROVE | REJECT | DEFER
  vote    String
  comment String?
  castAt  DateTime @default(now())

  @@unique([caseId, memberId])
  @@map("rnc_votes")
}


/* ─────────────────────────────────────────────────────────────────────────
   CPC standing composition, attendance and quorum
   CP-003 · CP-006 · CP-007 · CP-016

   Case membership was resolved per case from roles, which answers "who should
   look at this" and not "is this committee properly constituted". CP-003 names
   a standing composition of nine seats with designations and types; CP-006 sets
   a quorum to count; CP-007 says observers neither vote nor count. None of that
   is derivable from a role lookup, so the roster is its own record — the same
   shape as the RNC's, because the two clauses are written the same way.
   ───────────────────────────────────────────────────────────────────────── */

model CpcRosterMember {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id])

  userId String?
  user   User?   @relation("CpcRosterUser", fields: [userId], references: [id])
  /// The document names people who may not have accounts.
  memberName  String
  designation String?

  /// PERMANENT_MANDATORY | PERMANENT | OBSERVER — CP-007 makes the last one
  /// present but non-counting, so the arithmetic needs the distinction.
  memberType String  @default("PERMANENT")
  /// The committee's own chair, distinct from the requisitioner's department
  /// head that CP-006 requires in addition to the three.
  isChair    Boolean @default(false)

  active   Boolean @default(true)
  sequence Int     @default(0)

  attendance CpcAttendance[]

  @@unique([entityId, memberName])
  @@map("cpc_roster_members")
}

model CpcAttendance {
  id     String  @id @default(cuid())
  caseId String
  case   CpcCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  memberId String
  member   CpcRosterMember @relation(fields: [memberId], references: [id])

  /// PRESENT | PROXY | ABSENT
  attendance String  @default("ABSENT")
  /// CP-006 admits a nominated proxy, so who stood in is recorded.
  proxyName  String?
  note       String?

  @@unique([caseId, memberId])
  @@map("cpc_attendance")
}


/* ─────────────────────────────────────────────────────────────────────────
   Stacking taxonomy  ·  RC-016 · Annexure 5 Table 1.1

   "Table 1.1 Main Categories for Stacking of Goods" names ten: Electronics,
   Hardware, Grocery, Housekeeping, Stationery, Giveaways, IT Equipment,
   Furniture & Fixture, Branding Material, Printing Material.

   This is a *second* dimension, not the procurement category tree. The two
   answer different questions — the catalogue category decides who inspects and
   how it is accounted for; the stacking category decides where in the warehouse
   it goes and what it may be stacked beside. Collapsing them would force one
   taxonomy to serve both, which is why the existing category tree does not match
   the table.
   ───────────────────────────────────────────────────────────────────────── */

model StackingCategory {
  id       String @id @default(cuid())
  code     String @unique
  name     String
  sequence Int    @default(0)

  /// Annexure 5's own guidance for this class of goods, so the storekeeper is
  /// told what the rule is at the point of stacking rather than having to
  /// remember the annexure.
  guidance String?

  /// Annexure 5: "handsets, laptops and high-value goods in strong
  /// cabinets/strong rooms with entry/exit management".
  requiresSecureStorage Boolean @default(false)
  /// Annexure 5: "liquids on wooden pallets".
  requiresPallet        Boolean @default(false)
  /// Annexure 5: "not near wires/electrical appliances".
  keepFromElectrical    Boolean @default(false)
  /// Annexure 5: "heavy goods at ground level".
  groundLevelOnly       Boolean @default(false)

  active Boolean @default(true)

  items    Item[]
  stacking GoodsStacking[]

  @@map("stacking_categories")
}


/* ─────────────────────────────────────────────────────────────────────────
   Document revisions  ·  controlled amendment

   A requisition could not be edited once it left draft, which is a blunt
   protection: an approved requisition that genuinely needs a change had no
   route at all, so in practice the change happens by cancelling and re-raising,
   and the trail is lost.

   What was missing is versioning. An approval is given against a *state* of the
   document, and the only way to know whether that approval still covers what is
   there now is to keep the states. So each submission snapshots the document,
   and an amendment after approval bumps the version and sends it back — with a
   reason, and with what changed on the record.

   The same applies to an RFQ: RFQ amendment, cancellation and reissue were all
   absent, and a quotation received against version 1 of a scope is not a
   quotation for version 2.
   ───────────────────────────────────────────────────────────────────────── */

model DocumentRevision {
  id String @id @default(cuid())

  /// PR | RFQ — the kind of document this is a revision of.
  documentType String
  documentId   String
  documentRef  String

  /// 1 for the first submission, then up.
  version Int

  /// The document and its lines as they stood, as JSON. Held as a snapshot
  /// rather than a diff because a diff can only be read against the thing it
  /// came from, and the point of this is to be able to read a past version on
  /// its own.
  snapshot String

  /// A content hash of the snapshot, so a version can be compared to an
  /// attestation's `signedContent` hash without re-serialising it.
  contentHash String

  /// Why this version exists. Null on the first — nothing was amended.
  amendmentReason String?
  /// What actually changed from the previous version, in words, so the approver
  /// re-reading it does not have to diff two JSON blobs.
  changeSummary String?

  createdById String
  createdBy   User     @relation("RevisionCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  /// True while this is the version the document currently reflects.
  isCurrent Boolean @default(true)

  @@unique([documentType, documentId, version])
  @@index([documentType, documentId])
  @@map("document_revisions")
}
