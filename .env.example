# ─────────────────────────────────────────────────────────────
# Heimdall configuration.
#
# Copy to .env for local work. On Vercel set the same keys as
# project environment variables — .env is never committed.
# ─────────────────────────────────────────────────────────────

# Database — Supabase Postgres.
#   DATABASE_URL is the pooled connection (port 6543) the application uses:
#   serverless functions open and close constantly and Postgres cannot take that
#   directly. DIRECT_URL is the unpooled connection (port 5432) used only for
#   schema pushes, migrations and seeding.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Session signing. Generate a fresh value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Public address, used in the links inside notification emails.
APP_URL="http://localhost:3737"

# Document storage — local disk in development, a private bucket in production.
STORAGE_DRIVER="local"
UPLOAD_DIR="./storage/uploads"
# SUPABASE_URL="https://<project-ref>.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"   # server-side only, never public
# SUPABASE_STORAGE_BUCKET="heimdall-documents"

# Email. logger writes .eml files to the spool directory and sends nothing;
# http posts to any JSON mail API; none disables delivery entirely.
MAIL_TRANSPORT="logger"
MAIL_FROM="Heimdall <procurement@zameen.com>"
MAIL_SPOOL_DIR="./storage/mail"
# MAIL_ENDPOINT="https://api.resend.com/emails"
# MAIL_TOKEN="<api-key>"

# Shared secret for the scheduled outbox flush (/api/cron/mail).
# CRON_SECRET="<random-string>"
